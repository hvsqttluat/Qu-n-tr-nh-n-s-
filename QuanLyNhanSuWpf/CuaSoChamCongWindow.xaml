<Window x:Class="QuanLyNhanSuWpf.CuaSoChamCongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chấm công" Height="560" Width="680"
        MinHeight="500" MinWidth="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Border Margin="18" Style="{StaticResource TheThongKe}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Chấm công nhân viên" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}"/>
                <TextBlock Text="Ghi nhận vào ca, ra ca và theo dõi thời gian làm việc trong phạm vi được phân quyền." Style="{StaticResource MoTaNho}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Vào ca" Command="{Binding VaoCaLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"/>
                <Button Content="Ra ca" Command="{Binding RaCaLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                <Button Content="Điều chỉnh công đã chọn" Command="{Binding DieuChinhCongLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"
                        Visibility="{Binding CoQuyenDieuChinhCong, Converter={StaticResource HienThiTheoBool}}"/>
                <Button Content="Đóng" IsCancel="True" Style="{StaticResource NutPhu}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Nhân viên thao tác" Style="{StaticResource NhanTruong}"/>
                <ComboBox ItemsSource="{Binding NhanVienDangLamViecTrongPhamVi}" DisplayMemberPath="HoTen" SelectedItem="{Binding NhanVienDangChon, Mode=TwoWay}" Padding="10" Margin="0,0,0,16"/>

                <Border Background="#F8FAFC" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding NhanVienThaoTac}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource MauChuChinh}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TrangThaiCaDangChon}" Foreground="{StaticResource MauThanhCong}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CaGanNhatDangChon}" Style="{StaticResource MoTaNho}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding TongGioCongThangDangChon, StringFormat=Công tháng: {0:N2} giờ}" Foreground="{StaticResource MauXanhChuDao}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Ngày công quy đổi" Style="{StaticResource MoTaNho}"/>
                            <TextBlock Text="{Binding NgayCongQuyDoiDangChon, StringFormat={}{0:N2}}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource MauThanhCong}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Bản ghi công đang chọn" Style="{StaticResource MoTaNho}"/>
                            <TextBlock Text="{Binding ChamCongDangChon.KhungGioHienThi, TargetNullValue=Chưa chọn bản ghi}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
