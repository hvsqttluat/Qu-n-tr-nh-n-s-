                                                    <ComboBox ItemsSource="{Binding ViTriTheoPhongBanBieuMauNhanVien}" DisplayMemberPath="TenViTri" SelectedValuePath="MaViTri" SelectedValue="{Binding BieuMauNhanVien.MaViTri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,5,0,10"/>
                                                    <TextBlock Text="Ngày vào làm"/>
                                                    <DatePicker SelectedDate="{Binding BieuMauNhanVien.NgayVaoLam}" Margin="0,5,0,10"/>
                                                    <TextBlock Text="Trạng thái làm việc"/>
                                                    <ComboBox ItemsSource="{Binding CacTrangThaiLamViec}" SelectedItem="{Binding BieuMauNhanVien.TrangThaiLamViec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,5,0,16"/>

                                                    <TextBlock Text="LIÊN HỆ" Style="{StaticResource NhanTruong}"/>
                                                    <TextBlock Text="Liên hệ khẩn cấp"/>
                                                    <TextBox Text="{Binding BieuMauNhanVien.LienHeKhanCap, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,5,0,10"/>
                                                    <TextBlock Text="Tài khoản ngân hàng"/>
                                                    <TextBox Text="{Binding BieuMauNhanVien.TaiKhoanNganHang, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,5,0,18"/>

                                                    <Button Content="Lưu hồ sơ nhân viên" Command="{Binding LuuLenh}" Style="{StaticResource NutChinh}" Margin="0,0,0,10"/>
                                                    <Button Content="Lấy dữ liệu từ dòng đang chọn" Command="{Binding SuaLenh}" Style="{StaticResource NutPhu}"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </TabItem>

                                </TabControl>
                            </Grid>

                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Phòng ban}">
                                <TabControl Style="{StaticResource TabPhanHe}" ItemContainerStyle="{StaticResource TabPhanHeItem}">
                                    <TabItem Header="Danh sách phòng ban">
                                        <Border Style="{StaticResource TheThongKe}" Padding="0">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Margin="22,20,22,14">
                                                    <TextBlock Text="Cơ cấu phòng ban" Style="{StaticResource TieuDeKhuVuc}"/>
                                                    <TextBlock Text="Theo dõi đơn vị, người phụ trách và cấu trúc tổ chức." Style="{StaticResource MoTaNho}"/>
                                                </StackPanel>
                                                <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Tạo mới" Command="{Binding TaoPhongBanLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                                        <Button Content="Sửa phòng ban" Command="{Binding SuaPhongBanLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                                        <Button Content="Xóa" Command="{Binding XoaPhongBanLenh}" Style="{StaticResource NutNguyHiem}" Margin="0,0,8,0"/>
                                                        <Button Content="Làm mới" Command="{Binding TaiLaiLenh}" Style="{StaticResource NutPhu}"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel DockPanel.Dock="Top" Margin="22,16,22,10">
                                                    <TextBlock Text="Danh sách phòng ban" Style="{StaticResource TieuDeKhuVuc}"/>
                                                    <TextBlock Text="Theo dõi mã phòng, trưởng phòng, hồ sơ nhân viên, đánh giá và dữ liệu lương theo từng đơn vị." Style="{StaticResource MoTaNho}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <DataGrid ItemsSource="{Binding TongHopPhongBanDieuHanh}" SelectedItem="{Binding TongHopPhongBanDangChon, Mode=TwoWay}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Mã phòng" Binding="{Binding MaPhongBan}" Width="80"/>
                                                        <DataGridTextColumn Header="Tên phòng ban" Binding="{Binding TenPhongBan}" Width="150"/>
                                                        <DataGridTextColumn Header="Hồ sơ" Binding="{Binding SoNhanVien}" Width="65"/>
                                                        <DataGridTextColumn Header="Trưởng phòng" Binding="{Binding NhanSuCapCao}" Width="145"/>
                                                        <DataGridTextColumn Header="Xuất sắc nhất" Binding="{Binding CaNhanXuatSac}" Width="145"/>
                                                        <DataGridTextColumn Header="Điểm" Binding="{Binding DiemXuatSacHienThi}" Width="55"/>
                                                        <DataGridTextColumn Header="Lương cao nhất" Binding="{Binding NhanSuLuongCao}" Width="145"/>
                                                        <DataGridTextColumn Header="Mức lương" Binding="{Binding LuongCaoHienThi}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>

                                    <TabItem Header="Phiếu phòng ban" Visibility="Collapsed">
                                        <Border Style="{StaticResource TheThongKe}">
                                            <StackPanel MaxWidth="620">
                                                <TextBlock Text="Phiếu phòng ban" Style="{StaticResource TieuDeKhuVuc}"/>
                                                <TextBlock Text="Nhập tên phòng ban và chọn người phụ trách." Style="{StaticResource MoTaNho}" Margin="0,4,0,18"/>

                                                <TextBlock Text="Mã phòng" Style="{StaticResource NhanTruong}"/>
                                                <TextBox Text="{Binding BieuMauPhongBan.MaPhongBan}" Style="{StaticResource OThongTin}" IsReadOnly="True" Margin="0,0,0,12"/>

                                                <TextBlock Text="Tên phòng ban" Style="{StaticResource NhanTruong}"/>
                                                <TextBox Text="{Binding BieuMauPhongBan.TenPhongBan, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>

                                                <TextBlock Text="Trưởng phòng" Style="{StaticResource NhanTruong}"/>
                                                <ComboBox ItemsSource="{Binding NhanVienCoTheBoNhiemTruongPhong}" DisplayMemberPath="HoTen" SelectedValuePath="MaNhanVien" SelectedValue="{Binding BieuMauPhongBan.MaTruongPhong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,18"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Lưu thay đổi" Command="{Binding LuuPhongBanLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"/>
                                                    <Button Content="Xóa phòng ban" Command="{Binding XoaPhongBanLenh}" Style="{StaticResource NutNguyHiem}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>

                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Ứng viên}">
                                <TabControl Style="{StaticResource TabPhanHe}" ItemContainerStyle="{StaticResource TabPhanHeItem}">
                                    <TabItem Header="Danh sách tuyển dụng">
                                        <Border Style="{StaticResource TheThongKe}" Padding="0">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Margin="22,20,22,14">
                                                    <TextBlock Text="Danh sách tuyển dụng" Style="{StaticResource TieuDeKhuVuc}"/>
                                                    <TextBlock Text="Quản lý pipeline tuyển dụng theo vị trí và giai đoạn." Style="{StaticResource MoTaNho}"/>
                                                </StackPanel>
                                                <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Tạo ứng viên" Command="{Binding TaoMoiUngVienLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"/>
                                                        <Button Content="Chuyển bước tuyển dụng" Command="{Binding ChuyenGiaiDoanUngVienLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"
                                                                ToolTip="Mới → Sàng lọc hồ sơ → Phỏng vấn → Đề nghị nhận việc"/>
                                                        <Button Content="Sửa ứng viên" Command="{Binding SuaUngVienLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                                        <Button Content="Tiếp nhận thành nhân viên" Command="{Binding ChuyenUngVienThanhNhanVienLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"
                                                                ToolTip="Chỉ dùng khi ứng viên ở giai đoạn Đề nghị nhận việc. Sau khi tiếp nhận, ứng viên rời khỏi danh sách tuyển dụng."/>
                                                        <Button Content="Xuất hợp đồng làm việc" Command="{Binding XuatHopDongLamViecLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                                        <Button Content="Làm mới" Command="{Binding TaiLaiLenh}" Style="{StaticResource NutPhu}"/>
                                                    </StackPanel>
                                                </Border>
                                                <DataGrid ItemsSource="{Binding DanhSachUngVienView}" SelectedItem="{Binding UngVienDangChon}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="150"/>
                                                        <DataGridTextColumn Header="Vị trí ứng tuyển" Binding="{Binding ViTri}" Width="*"/>
                                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="190"/>
                                                        <DataGridTextColumn Header="Điện thoại" Binding="{Binding DienThoai}" Width="115"/>
                                                        <DataGridTextColumn Header="Giai đoạn" Binding="{Binding GiaiDoan}" Width="130"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>

                                    <TabItem Header="Phiếu tuyển dụng" Visibility="Collapsed">
                                        <Border Style="{StaticResource TheThongKe}">
                                            <StackPanel MaxWidth="620">
                                                <TextBlock Text="Phiếu tuyển dụng" Style="{StaticResource TieuDeKhuVuc}"/>
                                                <TextBlock Text="Tiếp nhận hoặc cập nhật hồ sơ ứng viên trong pipeline tuyển dụng." Style="{StaticResource MoTaNho}" Margin="0,4,0,18"/>
                                                <TextBlock Text="Họ tên" Style="{StaticResource NhanTruong}"/>
                                                <TextBox Text="{Binding BieuMauUngVien.HoTen, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                                                <TextBlock Text="Email" Style="{StaticResource NhanTruong}"/>
                                                <TextBox Text="{Binding BieuMauUngVien.Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                                                <TextBlock Text="Số điện thoại" Style="{StaticResource NhanTruong}"/>
                                                <TextBox Text="{Binding BieuMauUngVien.DienThoai, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                                                <TextBlock Text="Vị trí ứng tuyển" Style="{StaticResource NhanTruong}"/>
                                                <ComboBox ItemsSource="{Binding ViTriTrongPhamVi}" DisplayMemberPath="TenViTri" SelectedValuePath="MaViTri" SelectedValue="{Binding BieuMauUngVien.MaViTri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,12"/>
                                                <TextBlock Text="Giai đoạn" Style="{StaticResource NhanTruong}"/>
                                                <ComboBox ItemsSource="{Binding CacGiaiDoanUngVien}" SelectedItem="{Binding BieuMauUngVien.GiaiDoan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,18"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Tạo mới" Command="{Binding TaoMoiUngVienLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                                    <Button Content="Nạp dòng chọn" Command="{Binding SuaUngVienLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                                    <Button Content="Lưu ứng viên" Command="{Binding TaoUngVienLenh}" Style="{StaticResource NutChinh}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>

                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Chấm công}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,18">
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Lượt chấm công" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding SoChamCongDaLoc}" FontSize="30" FontWeight="SemiBold" Foreground="#172033" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding KhungThoiGianChamCong}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Đang trong ca" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding SoCaDangMoDaLoc}" FontSize="30" FontWeight="SemiBold" Foreground="#B45309" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding TyLeHoanTatChamCongDaLoc, StringFormat=Đã ra ca: {0}}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Tổng giờ công" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding TongGioChamCongDaLoc, StringFormat={}{0:N2} giờ}" FontSize="30" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding TongNgayCongChamCongDaLoc, StringFormat=Quy đổi: {0:N2} ngày}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource TheNho}">
                                        <StackPanel>
                                            <TextBlock Text="Cần rà soát" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding SoCaCanRaSoatDaLoc}" FontSize="30" FontWeight="SemiBold" Foreground="#B42318" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding NhanVienCongCaoHienThi, StringFormat=Công cao: {0}}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TabControl Grid.Row="1" Style="{StaticResource TabPhanHe}" ItemContainerStyle="{StaticResource TabPhanHeItem}">
                                    <TabItem Header="Bảng điều khiển ca">
                                        <Border Style="{StaticResource TheThongKe}">
                                            <StackPanel MaxWidth="720">
                                                <TextBlock Text="Bảng điều khiển ca" Style="{StaticResource TieuDeKhuVuc}"/>
                                                <TextBlock Text="Tình trạng ca của nhân viên đang chọn và công tháng hiện tại." Style="{StaticResource MoTaNho}" Margin="0,4,0,16"/>

                                                <TextBlock Text="NHÂN VIÊN THAO TÁC" Style="{StaticResource NhanTruong}"/>
                                                <ComboBox ItemsSource="{Binding NhanVienDangLamViecTrongPhamVi}" DisplayMemberPath="HoTen" SelectedItem="{Binding NhanVienDangChon, Mode=TwoWay}" Padding="10" Margin="0,0,0,16"/>

                                                <Grid Margin="0,0,0,16">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding NhanVienThaoTac}" FontWeight="SemiBold" Foreground="#172033" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding TrangThaiCaDangChon}" Foreground="#0F766E" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Row="2" Text="{Binding CaGanNhatDangChon}" Style="{StaticResource MoTaNho}" Margin="0,6,0,0"/>
                                                    <TextBlock Grid.Row="3" Text="{Binding TongGioCongThangDangChon, StringFormat=Công tháng: {0:N2} giờ}" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                    <Button Content="Mở cửa sổ chấm công" Command="{Binding MoChamCongLenh}" Style="{StaticResource NutChinh}"/>
                                                </StackPanel>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Ngày công" Style="{StaticResource MoTaNho}"/>
                                                        <TextBlock Text="{Binding NgayCongQuyDoiDangChon, StringFormat={}{0:N2}}" FontSize="24" FontWeight="SemiBold" Foreground="#0F766E"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Đủ công" Style="{StaticResource MoTaNho}"/>
                                                        <TextBlock Text="{Binding SoCaDuCongDaLoc}" FontSize="24" FontWeight="SemiBold" Foreground="#172033"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </TabItem>

                                    <TabItem Header="Sổ công vận hành">
                                        <Border Style="{StaticResource TheThongKe}" Padding="0">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Top" Margin="22,20,22,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Sổ công vận hành" Style="{StaticResource TieuDeKhuVuc}"/>
                                                        <TextBlock Text="Theo dõi ca làm theo ngày, phòng ban, trạng thái và nhân sự." Style="{StaticResource MoTaNho}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Làm mới" Command="{Binding TaiLaiLenh}" Style="{StaticResource NutPhu}" VerticalAlignment="Top"/>
                                                </Grid>

                                                <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                                    <WrapPanel>
                                                        <StackPanel Width="200" Margin="0,0,12,10">
                                                            <TextBlock Text="TỪ KHÓA" Style="{StaticResource NhanTruong}"/>
                                                            <TextBox Text="{Binding TuKhoaChamCong, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Padding="10" ToolTip="Tìm theo tên, phòng ban, chức vụ hoặc trạng thái"/>
                                                        </StackPanel>
                                                        <StackPanel Width="145" Margin="0,0,12,10">
                                                            <TextBlock Text="TỪ NGÀY" Style="{StaticResource NhanTruong}"/>
                                                            <DatePicker SelectedDate="{Binding TuNgayChamCong, Mode=TwoWay}"/>
                                                        </StackPanel>
                                                        <StackPanel Width="145" Margin="0,0,12,10">
                                                            <TextBlock Text="ĐẾN NGÀY" Style="{StaticResource NhanTruong}"/>
                                                            <DatePicker SelectedDate="{Binding DenNgayChamCong, Mode=TwoWay}"/>
                                                        </StackPanel>
                                                        <StackPanel Width="185" Margin="0,0,12,10">
                                                            <TextBlock Text="PHÒNG BAN" Style="{StaticResource NhanTruong}"/>
                                                            <ComboBox ItemsSource="{Binding CacPhongBanTraCuu}" SelectedItem="{Binding PhongBanChamCongDangChon, Mode=TwoWay}" Padding="10"/>
                                                        </StackPanel>
                                                        <StackPanel Width="165" Margin="0,0,0,10">
                                                            <TextBlock Text="TRẠNG THÁI" Style="{StaticResource NhanTruong}"/>
                                                            <ComboBox ItemsSource="{Binding CacTrangThaiChamCong}" SelectedItem="{Binding TrangThaiChamCongDangChon, Mode=TwoWay}" Padding="10"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </Border>

                                                <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="{StaticResource MauVien}" BorderThickness="0,0,0,1" Padding="18,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SoChamCongDaLoc, StringFormat=Bản ghi: {0}}" Foreground="#172033" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                                        <TextBlock Text="{Binding TongGioChamCongDaLoc, StringFormat=Tổng giờ: {0:N2}}" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                                        <TextBlock Text="{Binding TongNgayCongChamCongDaLoc, StringFormat=Ngày công: {0:N2}}" Foreground="#0F766E" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                                        <TextBlock Text="{Binding SoCaCanRaSoatDaLoc, StringFormat=Rà soát: {0}}" Foreground="#B42318" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>

                                                <DataGrid ItemsSource="{Binding DanhSachChamCongView}" SelectedItem="{Binding ChamCongDangChon}" Margin="0">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Ngày" Binding="{Binding NgayChamCongHienThi}" Width="90"/>
                                                        <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="*"/>
                                                        <DataGridTextColumn Header="Ca" Binding="{Binding CaLam}" Width="85"/>
                                                        <DataGridTextColumn Header="Khung giờ" Binding="{Binding KhungGioHienThi}" Width="120"/>
                                                        <DataGridTextColumn Header="Số giờ" Binding="{Binding SoGioTinhToan, StringFormat=N2}" Width="70"/>
                                                        <DataGridTextColumn Header="Ngày công" Binding="{Binding NgayCongQuyDoi, StringFormat=N2}" Width="80"/>
                                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiCong}" Width="105"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>

                                    <TabItem Header="Tổng hợp phòng ban">
                                        <Border Style="{StaticResource TheThongKe}" Padding="0">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Margin="22,20,22,14">
                                                    <TextBlock Text="Tổng hợp lương theo phòng ban" Style="{StaticResource TieuDeKhuVuc}"/>
                                                    <TextBlock Text="Gộp phiếu lương theo phòng ban để kiểm tra quỹ lương, phụ cấp, khấu trừ và thực lãnh trong kỳ." Style="{StaticResource MoTaNho}"/>
                                                </StackPanel>
                                                <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                                    <WrapPanel>
                                                        <StackPanel Width="220" Margin="0,0,12,10">
                                                            <TextBlock Text="KỲ TỔNG HỢP" Style="{StaticResource NhanTruong}"/>
                                                            <ComboBox ItemsSource="{Binding CacKyBaoCaoNhanSu}" SelectedItem="{Binding KyTongHopLuongDangChon, Mode=TwoWay}" Padding="10"/>
                                                        </StackPanel>
                                                        <StackPanel Width="210" Margin="0,0,14,10">
                                                            <TextBlock Text="PHÒNG BAN" Style="{StaticResource NhanTruong}"/>
                                                            <ComboBox ItemsSource="{Binding CacPhongBanTraCuu}" SelectedItem="{Binding PhongBanBangLuongDangChon, Mode=TwoWay}" Padding="10"/>
                                                        </StackPanel>
                                                        <StackPanel Width="240" Margin="0,0,14,10">
                                                            <TextBlock Text="TỪ KHÓA" Style="{StaticResource NhanTruong}"/>
                                                            <TextBox Text="{Binding TuKhoaBangLuong, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Padding="10"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </Border>
                                                <DataGrid ItemsSource="{Binding TongHopLuongTheoPhongBan}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Phòng ban" Binding="{Binding PhongBan}" Width="220"/>
                                                        <DataGridTextColumn Header="Kỳ" Binding="{Binding Ky}" Width="130"/>
                                                        <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="90"/>
                                                        <DataGridTextColumn Header="Tổng lương cơ bản" Binding="{Binding TongLuongCoBan, StringFormat={}{0:N0} đ}" Width="160"/>
                                                        <DataGridTextColumn Header="Tổng phụ cấp" Binding="{Binding TongPhuCap, StringFormat={}{0:N0} đ}" Width="140"/>
                                                        <DataGridTextColumn Header="Tổng khấu trừ" Binding="{Binding TongKhauTru, StringFormat={}{0:N0} đ}" Width="140"/>
                                                        <DataGridTextColumn Header="Tổng thực lãnh" Binding="{Binding TongThucLanh, StringFormat={}{0:N0} đ}" Width="160"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>

                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Nghỉ phép}">
                                <TabControl Style="{StaticResource TabPhanHe}" ItemContainerStyle="{StaticResource TabPhanHeItem}" SelectedIndex="1">
                                    <TabItem Header="Tạo đơn nghỉ" Visibility="Collapsed">
                                        <Border Style="{StaticResource TheThongKe}">
                                            <StackPanel MaxWidth="620">
                                                <TextBlock Text="Tạo đơn nghỉ" Style="{StaticResource TieuDeKhuVuc}"/>
