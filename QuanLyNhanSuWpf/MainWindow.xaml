                                                <TextBlock Text="Loại nghỉ" Style="{StaticResource NhanTruong}"/>
                                                <TextBox Text="{Binding BieuMauNghiPhep.LoaiNghi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                                                <TextBlock Text="Từ ngày" Style="{StaticResource NhanTruong}"/>
                                                <DatePicker SelectedDate="{Binding BieuMauNghiPhep.TuNgay}" Margin="0,0,0,12"/>
                                                <TextBlock Text="Đến ngày" Style="{StaticResource NhanTruong}"/>
                                                <DatePicker SelectedDate="{Binding BieuMauNghiPhep.DenNgay}" Margin="0,0,0,18"/>
                                                <Button Content="Gửi đơn nghỉ" Command="{Binding TaoNghiPhepLenh}" Style="{StaticResource NutChinh}" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>
                                    </TabItem>

                                    <TabItem Header="Duyệt nghỉ phép">
                                        <Border Style="{StaticResource TheThongKe}" Padding="0">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Margin="22,20,22,14">
                                                    <TextBlock Text="Hàng đợi duyệt nghỉ phép" Style="{StaticResource TieuDeKhuVuc}"/>
                                                    <TextBlock Text="Quản lý trạng thái chờ duyệt, đã duyệt hoặc từ chối." Style="{StaticResource MoTaNho}"/>
                                                </StackPanel>
                                                <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                                    <WrapPanel>
                                                        <StackPanel Width="170" Margin="0,0,12,10">
                                                            <TextBlock Text="KỲ NGHỈ PHÉP" Style="{StaticResource NhanTruong}"/>
                                                            <ComboBox ItemsSource="{Binding CacKyBaoCaoNhanSu}" SelectedItem="{Binding KyNghiPhepDangChon, Mode=TwoWay}" Padding="10"/>
                                                        </StackPanel>
                                                        <StackPanel Width="210" Margin="0,0,12,10">
                                                            <TextBlock Text="PHÒNG BAN" Style="{StaticResource NhanTruong}"/>
                                                            <ComboBox ItemsSource="{Binding CacPhongBanTraCuu}" SelectedItem="{Binding PhongBanNghiPhepDangChon, Mode=TwoWay}" Padding="10"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,18,10">
                                                            <Button Content="Tạo đơn nghỉ" Command="{Binding MoTaoNghiPhepLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"/>
                                                            <Button Content="Duyệt đơn" Command="{Binding DuyetNghiPhepLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"
                                                                    Visibility="{Binding CoQuyenDuyetNghiPhep, Converter={StaticResource HienThiTheoBool}}"/>
                                                            <Button Content="Từ chối" Command="{Binding TuChoiNghiPhepLenh}" Style="{StaticResource NutNguyHiem}" Margin="0,0,8,0"
                                                                    Visibility="{Binding CoQuyenDuyetNghiPhep, Converter={StaticResource HienThiTheoBool}}"/>
                                                            <Button Content="Làm mới" Command="{Binding TaiLaiLenh}" Style="{StaticResource NutPhu}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                                            <TextBlock Text="{Binding SoNghiPhepDaLoc, StringFormat=Đơn: {0}}" Foreground="#172033" FontWeight="SemiBold" Margin="0,0,18,0"/>
                                                            <TextBlock Text="{Binding SoNghiPhepChoDuyetDaLoc, StringFormat=Chờ duyệt: {0}}" Foreground="#B42318" FontWeight="SemiBold" Margin="0,0,18,0"/>
                                                            <TextBlock Text="{Binding SoNghiPhepDaDuyetDaLoc, StringFormat=Đã duyệt: {0}}" Foreground="#0F766E" FontWeight="SemiBold" Margin="0,0,18,0"/>
                                                            <TextBlock Text="{Binding SoNgayNghiPhepDaLoc, StringFormat=Tổng ngày: {0:N2}}" Foreground="#2563EB" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </Border>
                                                <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="{StaticResource MauVien}" BorderThickness="0,0,0,1" Padding="18,10">
                                                    <TextBlock Text="{Binding MoTaBoLocNghiPhep}" Foreground="#172033" FontWeight="SemiBold"/>
                                                </Border>
                                                <DataGrid ItemsSource="{Binding DanhSachDeNghiNghiPhepView}" SelectedItem="{Binding NghiPhepDangChon}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="145"/>
                                                        <DataGridTextColumn Header="Chức vụ/Phòng ban" Binding="{Binding ChucVuPhongBan}" Width="210"/>
                                                        <DataGridTextColumn Header="Loại nghỉ" Binding="{Binding LoaiNghi}" Width="130"/>
                                                        <DataGridTextColumn Header="Từ ngày" Binding="{Binding TuNgay, StringFormat=dd/MM/yyyy}" Width="90"/>
                                                        <DataGridTextColumn Header="Đến ngày" Binding="{Binding DenNgay, StringFormat=dd/MM/yyyy}" Width="90"/>
                                                        <DataGridTextColumn Header="Số ngày" Binding="{Binding SoNgay}" Width="65"/>
                                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="95"/>
                                                        <DataGridTemplateColumn Header="Lý do xử lý" Width="*">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding LyDoXuLy, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" BorderBrush="#CBD5E1" BorderThickness="1"
                                                                             ToolTip="Nhập lý do trước khi bấm Duyệt hoặc Từ chối"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="Xử lý" Width="145">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Button Content="Duyệt"
                                                                                Command="{Binding DataContext.DuyetNghiPhepDongLenh, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource NutChinh}" Padding="10,6" Margin="0,0,8,0"/>
                                                                        <Button Content="Từ chối"
                                                                                Command="{Binding DataContext.TuChoiNghiPhepDongLenh, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource NutNguyHiem}" Padding="10,6"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>

                                    <TabItem Header="Đơn đã duyệt">
                                        <Border Style="{StaticResource TheThongKe}" Padding="0">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Margin="22,20,22,14">
                                                    <TextBlock Text="Danh sách nghỉ phép đã duyệt" Style="{StaticResource TieuDeKhuVuc}"/>
                                                    <TextBlock Text="Các đơn đã duyệt theo kỳ và phòng ban đang lọc." Style="{StaticResource MoTaNho}"/>
                                                </StackPanel>
                                                <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                                    <WrapPanel>
                                                        <StackPanel Width="170" Margin="0,0,12,10">
                                                            <TextBlock Text="KỲ NGHỈ PHÉP" Style="{StaticResource NhanTruong}"/>
                                                            <ComboBox ItemsSource="{Binding CacKyBaoCaoNhanSu}" SelectedItem="{Binding KyNghiPhepDangChon, Mode=TwoWay}" Padding="10"/>
                                                        </StackPanel>
                                                        <StackPanel Width="210" Margin="0,0,12,10">
                                                            <TextBlock Text="PHÒNG BAN" Style="{StaticResource NhanTruong}"/>
                                                            <ComboBox ItemsSource="{Binding CacPhongBanTraCuu}" SelectedItem="{Binding PhongBanNghiPhepDangChon, Mode=TwoWay}" Padding="10"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                                            <TextBlock Text="{Binding SoNghiPhepDaDuyetDaLoc, StringFormat=Đã duyệt: {0}}" Foreground="#0F766E" FontWeight="SemiBold" Margin="0,0,18,0"/>
                                                            <TextBlock Text="{Binding SoNgayNghiPhepDaLoc, StringFormat=Tổng ngày theo bộ lọc: {0:N2}}" Foreground="#2563EB" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </Border>
                                                <DataGrid ItemsSource="{Binding DanhSachNghiPhepDaDuyetView}" SelectedItem="{Binding NghiPhepDangChon}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="190"/>
                                                        <DataGridTextColumn Header="Chức vụ/Phòng ban" Binding="{Binding ChucVuPhongBan}" Width="230"/>
                                                        <DataGridTextColumn Header="Loại nghỉ" Binding="{Binding LoaiNghi}" Width="150"/>
                                                        <DataGridTextColumn Header="Từ ngày" Binding="{Binding TuNgay, StringFormat=dd/MM/yyyy}" Width="110"/>
                                                        <DataGridTextColumn Header="Đến ngày" Binding="{Binding DenNgay, StringFormat=dd/MM/yyyy}" Width="110"/>
                                                        <DataGridTextColumn Header="Số ngày" Binding="{Binding SoNgay}" Width="80"/>
                                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120"/>
                                                        <DataGridTextColumn Header="Ghi chú xử lý" Binding="{Binding LyDoXuLy}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>

                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Đánh giá}">
                                <TabControl Style="{StaticResource TabPhanHe}" ItemContainerStyle="{StaticResource TabPhanHeItem}" SelectedIndex="{Binding TabDanhGiaDangChon, Mode=TwoWay}">
                                    <TabItem Header="Phiếu đánh giá" Visibility="Collapsed">
                                        <Border Style="{StaticResource TheThongKe}">
                                            <StackPanel MaxWidth="760">
                                                <TextBlock Text="Phiếu đánh giá" Style="{StaticResource TieuDeKhuVuc}"/>
                                                <TextBlock Text="Kỳ, điểm số, nhận xét và trạng thái xử lý." Style="{StaticResource MoTaNho}" Margin="0,4,0,18"/>

                                                <TextBlock Text="Nhân viên" Style="{StaticResource NhanTruong}"/>
                                                <ComboBox ItemsSource="{Binding NhanVienDangLamViecTrongPhamVi}" DisplayMemberPath="HoTen" SelectedValuePath="MaNhanVien" SelectedValue="{Binding BieuMauDanhGia.MaNhanVien}" Padding="10" Margin="0,0,0,12"/>

                                                <TextBlock Text="Người đánh giá" Style="{StaticResource NhanTruong}"/>
                                                <ComboBox ItemsSource="{Binding NhanVienDangLamViecTrongPhamVi}" DisplayMemberPath="HoTen" SelectedValuePath="MaNhanVien" SelectedValue="{Binding BieuMauDanhGia.MaNguoiDanhGia}" Padding="10" Margin="0,0,0,12"/>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Kỳ đánh giá" Style="{StaticResource NhanTruong}"/>
                                                        <TextBox Text="{Binding BieuMauDanhGia.KyDanhGia, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Điểm" Style="{StaticResource NhanTruong}"/>
                                                        <TextBox Text="{Binding BieuMauDanhGia.Diem, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Trạng thái" Style="{StaticResource NhanTruong}"/>
                                                <ComboBox ItemsSource="{Binding CacTrangThaiDanhGia}" SelectedItem="{Binding BieuMauDanhGia.TrangThai}" Padding="10" Margin="0,0,0,12"/>

                                                <TextBlock Text="Nhận xét" Style="{StaticResource NhanTruong}"/>
                                                <TextBox Text="{Binding BieuMauDanhGia.NhanXet, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" MinHeight="118" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Tạo mới" Command="{Binding TaoMoiDanhGiaLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                                    <Button Content="Lưu đánh giá" Command="{Binding TaoDanhGiaLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"/>
                                                    <Button Content="Nạp dòng đang chọn để sửa" Command="{Binding SuaDanhGiaLenh}" Style="{StaticResource NutPhu}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </TabItem>

                                    <TabItem Header="Danh sách đánh giá">
                                        <Border Style="{StaticResource TheThongKe}" Padding="0">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Top" Margin="22,20,22,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Đánh giá năng lực" Style="{StaticResource TieuDeKhuVuc}"/>
                                                        <TextBlock Text="Theo dõi chu kỳ đánh giá, điểm số, nhận xét và trạng thái hoàn tất." Style="{StaticResource MoTaNho}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Làm mới" Command="{Binding TaiLaiLenh}" Style="{StaticResource NutPhu}" VerticalAlignment="Top"/>
                                                </Grid>

                                                <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                                    <WrapPanel>
                                                        <StackPanel Width="230" Margin="0,0,12,10">
                                                            <TextBlock Text="TÌM ĐÁNH GIÁ" Style="{StaticResource NhanTruong}"/>
                                                            <TextBox Text="{Binding TuKhoaDanhGia, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Padding="10"
                                                                     ToolTip="Tìm theo nhân viên, người đánh giá, phòng ban, chức vụ, kỳ hoặc trạng thái"/>
                                                        </StackPanel>
                                                        <StackPanel Width="210" Margin="0,0,14,10">
                                                            <TextBlock Text="PHÒNG BAN" Style="{StaticResource NhanTruong}"/>
                                                            <ComboBox ItemsSource="{Binding CacPhongBanTraCuu}" SelectedItem="{Binding PhongBanDanhGiaDangChon, Mode=TwoWay}" Padding="10"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                                            <Button Content="Tạo đánh giá" Command="{Binding TaoMoiDanhGiaLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"
                                                                    Visibility="{Binding CoQuyenGhiNhanDanhGia, Converter={StaticResource HienThiTheoBool}}"/>
                                                            <Button Content="Sửa đánh giá" Command="{Binding SuaDanhGiaLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"
                                                                    Visibility="{Binding CoQuyenGhiNhanDanhGia, Converter={StaticResource HienThiTheoBool}}"/>
                                                            <Button Content="Chốt kết quả" Command="{Binding ChotDanhGiaLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"
                                                                    Visibility="{Binding CoQuyenGhiNhanDanhGia, Converter={StaticResource HienThiTheoBool}}"/>
                                                            <Button Content="Xóa đánh giá" Command="{Binding XoaDanhGiaLenh}" Style="{StaticResource NutNguyHiem}"
                                                                    Visibility="{Binding CoQuyenGhiNhanDanhGia, Converter={StaticResource HienThiTheoBool}}"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </Border>

                                                <DataGrid ItemsSource="{Binding DanhSachDanhGiaView}" SelectedItem="{Binding DanhGiaDangChon}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="190"/>
                                                        <DataGridTextColumn Header="Người đánh giá" Binding="{Binding NguoiDanhGia}" Width="190"/>
                                                        <DataGridTextColumn Header="Kỳ" Binding="{Binding KyDanhGia}" Width="110"/>
                                                        <DataGridTextColumn Header="Điểm" Binding="{Binding Diem, StringFormat=N1}" Width="80"/>
                                                        <DataGridTextColumn Header="Nhận xét" Binding="{Binding NhanXet}" Width="*"/>
                                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="130"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>

                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Bảng lương}">
                                <TabControl Style="{StaticResource TabPhanHe}" ItemContainerStyle="{StaticResource TabPhanHeItem}" SelectedIndex="1">
                                    <TabItem Header="Phiếu tính lương" Visibility="Collapsed">
                                        <Border Style="{StaticResource TheThongKe}">
                                            <StackPanel MaxWidth="720">
                                                <TextBlock Text="Tính lương nhân viên" Style="{StaticResource TieuDeKhuVuc}"/>
