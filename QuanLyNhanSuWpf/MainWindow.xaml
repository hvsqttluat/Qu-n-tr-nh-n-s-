<Window x:Class="QuanLyNhanSuWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuanLyNhanSuWpf"
        Title="Quản trị nhân sự" Height="860" Width="1440"
        MinHeight="780" MinWidth="1200" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <local:BangNhauThanhHienThi x:Key="HienThiTheoMuc"/>
        <local:BoolThanhHienThi x:Key="HienThiTheoBool"/>

        <Style x:Key="TieuDeKhuVuc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
        </Style>

        <Style x:Key="MoTaNho" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MauChuPhu}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="NhanTruong" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="NutNguyHiem" TargetType="Button" BasedOn="{StaticResource NutPhu}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="{StaticResource MauNguyHiem}"/>
        </Style>

        <Style x:Key="NutThanhBen" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DDE7F3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Nen" CornerRadius="7" Padding="12,10" Background="Transparent">
                            <DockPanel>
                                <Border x:Name="Cham" Width="7" Height="7" CornerRadius="4" Background="Transparent" DockPanel.Dock="Left" Margin="0,0,12,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Nen" Property="Background" Value="#E8F5F3"/>
                                <Setter TargetName="Cham" Property="Background" Value="#0F766E"/>
                                <Setter Property="Foreground" Value="#123F3B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Nen" Property="Background" Value="#223044"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VienCongCu" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource MauVien}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style x:Key="TheNho" TargetType="Border" BasedOn="{StaticResource TheThongKe}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="TabPhanHe" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="TabPhanHeItem" TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource MauNenUngDung}">
        <Border Margin="18,18,18,30" CornerRadius="8" Background="#F8FAFC" BorderBrush="#D8E0EA" BorderThickness="1">
            <Grid Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CotThanhBen" Width="288"/>
                    <ColumnDefinition x:Name="CotKhoangCach" Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ThanhBen" Grid.Column="0" CornerRadius="8" Padding="16" Margin="0,0,0,17">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#101827" Offset="0"/>
                            <GradientStop Color="#172033" Offset="0.55"/>
                            <GradientStop Color="#0F2F36" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel x:Name="DauThanhBen" Grid.Row="0" Margin="0,0,0,14">
                            <Border x:Name="LogoHr" Width="54" Height="54" CornerRadius="8" Background="#0F766E" BorderBrush="#66CFFAFE" BorderThickness="1"
                                    DockPanel.Dock="Left" Margin="0,0,14,0" Cursor="Hand" ToolTip="Thu gọn hoặc mở rộng thanh bên" MouseLeftButtonUp="LogoHr_Click">
                                <TextBlock Text="HR" Foreground="White" FontWeight="Black" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel x:Name="NhanThuongHieu" VerticalAlignment="Center">
                                <TextBlock Text="Quản trị nhân sự" Foreground="White" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Enterprise HR Operations" Foreground="#A7C7D0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>

                        <Border x:Name="ThePhienLamViec" Grid.Row="1" Background="#1B2738" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="#0F766E" VerticalAlignment="Center">
                                    <TextBlock Text="HR" Foreground="White" FontWeight="Black" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="PHIÊN LÀM VIỆC" Foreground="#A7C7D0" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding VaiTroNguoiDung, StringFormat=Vai trò: \{0\}}" Foreground="#FFFFFF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PhamViDuLieuHienThi, StringFormat=Phạm vi: \{0\}}" Foreground="#D9F3F1" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding PhamViDuLieuHienThi}"/>
                                    <TextBlock Text="{Binding ThoiGianHienTai}" Foreground="#A7C7D0" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="VungMenuThanhBen" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                            <TextBlock Text="PHÂN HỆ" Foreground="#A7C7D0" FontSize="11" FontWeight="Bold" Margin="4,0,0,8"/>
                            <RadioButton Content="Tổng quan vận hành" GroupName="Menu" IsChecked="{Binding DangXemTongQuan, Mode=OneWay}" Style="{StaticResource NutThanhBen}"
                                         Command="{Binding ChonMucLenh}" CommandParameter="Tổng quan"
                                         Visibility="{Binding CoQuyenTongQuan, Converter={StaticResource HienThiTheoBool}}"/>
                            <RadioButton Content="Tuyển dụng" GroupName="Menu" Style="{StaticResource NutThanhBen}"
                                         Command="{Binding ChonMucLenh}" CommandParameter="Ứng viên" IsEnabled="{Binding CoQuyenTuyenDung}"
                                         Visibility="{Binding CoQuyenTuyenDung, Converter={StaticResource HienThiTheoBool}}"/>
                            <RadioButton Content="Hồ sơ nhân viên" GroupName="Menu" Style="{StaticResource NutThanhBen}"
                                         Command="{Binding ChonMucLenh}" CommandParameter="Nhân viên" IsEnabled="{Binding CoQuyenHoSoNhanVien}"
                                         Visibility="{Binding CoQuyenHoSoNhanVien, Converter={StaticResource HienThiTheoBool}}"/>
                            <RadioButton Content="Thông báo" GroupName="Menu" Style="{StaticResource NutThanhBen}"
                                         Command="{Binding ChonMucLenh}" CommandParameter="Thông báo" IsEnabled="{Binding CoQuyenThongBao}"
                                         Visibility="{Binding CoQuyenThongBao, Converter={StaticResource HienThiTheoBool}}"/>
                            <RadioButton Content="Cơ cấu phòng ban" GroupName="Menu" Style="{StaticResource NutThanhBen}"
                                         Command="{Binding ChonMucLenh}" CommandParameter="Phòng ban" IsEnabled="{Binding CoQuyenPhongBan}"
                                         Visibility="{Binding CoQuyenPhongBan, Converter={StaticResource HienThiTheoBool}}"/>
                            <RadioButton Content="Chấm công" GroupName="Menu" Style="{StaticResource NutThanhBen}"
                                         Command="{Binding ChonMucLenh}" CommandParameter="Chấm công" IsEnabled="{Binding CoQuyenChamCong}"
                                         Visibility="{Binding CoQuyenChamCong, Converter={StaticResource HienThiTheoBool}}"/>
                            <RadioButton Content="Nghỉ phép" GroupName="Menu" Style="{StaticResource NutThanhBen}"
                                         Command="{Binding ChonMucLenh}" CommandParameter="Nghỉ phép" IsEnabled="{Binding CoQuyenNghiPhep}"
                                         Visibility="{Binding CoQuyenNghiPhep, Converter={StaticResource HienThiTheoBool}}"/>
                            <RadioButton Content="Đánh giá năng lực" GroupName="Menu" Style="{StaticResource NutThanhBen}"
                                         Command="{Binding ChonMucLenh}" CommandParameter="Đánh giá" IsEnabled="{Binding CoQuyenDanhGia}"
                                         Visibility="{Binding CoQuyenDanhGia, Converter={StaticResource HienThiTheoBool}}"/>
                            <RadioButton Content="Bảng lương" GroupName="Menu" Style="{StaticResource NutThanhBen}"
                                         Command="{Binding ChonMucLenh}" CommandParameter="Bảng lương" IsEnabled="{Binding CoQuyenBangLuong}"
                                         Visibility="{Binding CoQuyenBangLuong, Converter={StaticResource HienThiTheoBool}}"/>
                            <RadioButton Content="Báo cáo nhân sự" GroupName="Menu" Style="{StaticResource NutThanhBen}"
                                         Command="{Binding ChonMucLenh}" CommandParameter="Báo cáo" IsEnabled="{Binding CoQuyenBaoCaoNhanSu}"
                                         Visibility="{Binding CoQuyenBaoCaoNhanSu, Converter={StaticResource HienThiTheoBool}}"/>
                            <RadioButton Content="Cài đặt tài khoản" GroupName="Menu" Style="{StaticResource NutThanhBen}"
                                         Command="{Binding ChonMucLenh}" CommandParameter="Cài đặt tài khoản" IsEnabled="{Binding CoQuyenCaiDatTaiKhoan}"
                                         Visibility="{Binding CoQuyenCaiDatTaiKhoan, Converter={StaticResource HienThiTheoBool}}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="TheDuLieuThanhBen" Grid.Row="3" Background="#0E242A" CornerRadius="8" Padding="12" Margin="0,14,0,0" BorderBrush="#24545A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Dữ liệu" Foreground="#A7C7D0" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding NguonDuLieu}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding NguonDuLieu}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Đồng bộ" Command="{Binding TaiLaiLenh}" Style="{StaticResource NutPhu}" Padding="10,7" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border CornerRadius="8" Padding="18,14" Margin="0,0,0,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1F6F78" Offset="0"/>
                                <GradientStop Color="#2563EB" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="HỆ THỐNG QUẢN TRỊ NHÂN SỰ" Foreground="#D9F3F1" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TieuDeManHinh}" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                <TextBlock Text="Theo dõi nhân sự, thông báo, lương và tuyển dụng bằng các biểu đồ trực quan."
                                           Foreground="#EAF7F6" FontSize="13" TextWrapping="Wrap" MaxWidth="680"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#22FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="THÔNG BÁO CHƯA ĐỌC" Foreground="#D9F3F1" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SoThongBaoChuaDoc}" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding SoThongBao, StringFormat=Tổng {0} thông báo}" Foreground="#EAF7F6" FontSize="12"/>
                                        <TextBlock Text="{Binding ThoiGianHienTai}" Foreground="#D9F3F1" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="Tạo thông báo" Command="{Binding TaoThongBaoThuLenh}" Style="{StaticResource NutPhu}" Padding="10,7" Margin="0,0,0,6"
                                                ToolTip="Admin, Giám đốc, Trưởng phòng và Nhân sự được tạo thông báo."
                                                Visibility="{Binding CoQuyenTaoThongBao, Converter={StaticResource HienThiTheoBool}}"/>
                                        <Button Content="Tải lại" Command="{Binding TaiLaiLenh}" Style="{StaticResource NutPhu}" Padding="10,7" Margin="0,0,0,6"/>
                                        <Button Content="Đăng xuất" Click="DangXuat_Click" Style="{StaticResource NutNguyHiem}" Padding="10,7"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.RowSpan="3" Panel.ZIndex="20" Visibility="{Binding HienThiThongBaoNhanh}"
                            Background="{StaticResource MauThanhCong}" CornerRadius="8" Padding="14,10" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,14,14,0" MaxWidth="520">
                        <TextBlock Text="{Binding ThongBaoNhanh}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="1" Visibility="{Binding HienThiBieuMauThongBaoChung}" Background="#FFFFFF" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Tạo thông báo" Style="{StaticResource TieuDeKhuVuc}"/>
                                <TextBlock Text="Nhập nội dung thông báo và gửi cho người dùng trong hệ thống." Style="{StaticResource MoTaNho}" Margin="0,4,0,12"/>
                                <TextBlock Text="Tiêu đề thông báo" Style="{StaticResource NhanTruong}"/>
                                <TextBox Text="{Binding TieuDeThongBaoMoi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}"/>
                            </StackPanel>

                            <Grid Grid.Column="2" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Phân hệ" Style="{StaticResource NhanTruong}"/>
                                    <ComboBox ItemsSource="{Binding CacPhanHeThongBao}" SelectedItem="{Binding PhanHeThongBaoMoi}" Padding="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mức độ" Style="{StaticResource NhanTruong}"/>
                                    <ComboBox ItemsSource="{Binding CacMucDoThongBao}" SelectedItem="{Binding MucDoThongBaoMoi}" Padding="10"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <TextBlock Text="Nội dung" Style="{StaticResource NhanTruong}"/>
                                <TextBox Text="{Binding NoiDungThongBaoMoi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Tệp đính kèm" Style="{StaticResource NhanTruong}"/>
                                    <TextBlock Text="{Binding TenTepThongBaoHienThi}" Style="{StaticResource MoTaNho}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Content="Chọn tệp" Command="{Binding ChonTepThongBaoLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                    <Button Content="Bỏ tệp" Command="{Binding XoaTepThongBaoLenh}" Style="{StaticResource NutNguyHiem}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Hủy" Command="{Binding HuyTaoThongBaoLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                <Button Content="Gửi thông báo" Command="{Binding GuiThongBaoLenh}" Style="{StaticResource NutChinh}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="CuonNoiDung_PreviewMouseWheel">
                        <Grid>
                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Tổng quan}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,18">
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Tổng nhân sự" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding TongNhanVien}" FontSize="32" FontWeight="SemiBold" Foreground="#172033" Margin="0,8,0,0"/>
                                            <TextBlock Text="Hồ sơ trong hệ thống" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Quân số hiện diện" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding DangLamViec}" FontSize="32" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding NhanSuConHieuLuc, StringFormat=Trên {0} hồ sơ hiệu lực}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Vắng/tạm nghỉ" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding TamNghi}" FontSize="32" FontWeight="SemiBold" Foreground="#B45309" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding NghiPhepDaDuyetHomNay, StringFormat=Nghỉ duyệt hôm nay: {0}}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource TheNho}">
                                        <StackPanel>
                                            <TextBlock Text="Thông báo chưa đọc" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding SoThongBaoChuaDoc}" FontSize="32" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding SoThongBao, StringFormat=Tổng {0} thông báo}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Grid.Row="1" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.85*"/>
                                        <ColumnDefinition Width="1.35*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource TheThongKe}" Margin="0,0,18,0">
                                        <StackPanel>
                                            <TextBlock Text="Cơ cấu quân số theo kỳ" Style="{StaticResource TieuDeKhuVuc}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TomTatBaoCaoNhanSu}" Style="{StaticResource MoTaNho}" Margin="0,4,0,10" MaxHeight="62"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Kỳ báo cáo" Style="{StaticResource NhanTruong}" VerticalAlignment="Center" Margin="0"/>
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding CacKyBaoCaoNhanSu}" SelectedItem="{Binding KyBaoCaoNhanSuDangChon, Mode=TwoWay}" Padding="9" MinWidth="150"/>
                                            </Grid>

                                            <local:BieuDoTronNhanSu Height="190" DangLamViec="{Binding QuanSoHienDienTrongKyBaoCao}" TamNghi="{Binding NhanSuNghiDaDuyetTrongKyBaoCao}"/>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                                    <Border Width="12" Height="12" CornerRadius="6" Background="#0F766E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding QuanSoHienDienTrongKyBaoCao, StringFormat=Hiện diện: {0}}" FontWeight="SemiBold" Foreground="#172033"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="12" Height="12" CornerRadius="6" Background="#B45309" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding NhanSuNghiDaDuyetTrongKyBaoCao, StringFormat=Nghỉ đã duyệt: {0}}" FontWeight="SemiBold" Foreground="#172033"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="12">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding TieuDeAiDangNghi}" FontWeight="SemiBold" Foreground="#172033"/>
                                                        <TextBlock Text="{Binding MoTaAiDangNghi}" Style="{StaticResource MoTaNho}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <ScrollViewer MaxHeight="92" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding DanhSachNghiPhepDaDuyetTheoKy}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,8">
