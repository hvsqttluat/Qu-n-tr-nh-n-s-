                                        <TextBox Text="{Binding BieuMauUngVien.HoTen, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Email" Style="{StaticResource NhanTruong}"/>
                                        <TextBox Text="{Binding BieuMauUngVien.Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Số điện thoại" Style="{StaticResource NhanTruong}"/>
                                        <TextBox Text="{Binding BieuMauUngVien.DienThoai, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Vị trí ứng tuyển" Style="{StaticResource NhanTruong}"/>
                                        <ComboBox ItemsSource="{Binding ViTriTrongPhamVi}" DisplayMemberPath="TenViTri" SelectedValuePath="MaViTri" SelectedValue="{Binding BieuMauUngVien.MaViTri}" Padding="10" Margin="0,0,0,18"/>
                                        <Button Content="Tạo ứng viên" Command="{Binding TaoUngVienLenh}" Style="{StaticResource NutChinh}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource TheThongKe}" Padding="0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="22,20,22,14">
                                            <TextBlock Text="Danh sách ứng viên" Style="{StaticResource TieuDeKhuVuc}"/>
                                            <TextBlock Text="Quản lý pipeline tuyển dụng theo vị trí và giai đoạn." Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Chuyển bước tuyển dụng" Command="{Binding ChuyenGiaiDoanUngVienLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"
                                                        ToolTip="Mới → Sàng lọc hồ sơ → Phỏng vấn → Đề nghị nhận việc"/>
                                                <Button Content="Tiếp nhận thành nhân viên" Command="{Binding ChuyenUngVienThanhNhanVienLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"
                                                        ToolTip="Chỉ dùng khi ứng viên ở giai đoạn Đề nghị nhận việc. Sau khi tiếp nhận, ứng viên rời khỏi danh sách tuyển dụng."/>
                                                <Button Content="Xuất hợp đồng làm việc" Command="{Binding XuatHopDongLamViecLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                                <Button Content="Làm mới" Command="{Binding TaiLaiLenh}" Style="{StaticResource NutPhu}"/>
                                            </StackPanel>
                                        </Border>
                                        <DataGrid ItemsSource="{Binding DanhSachUngVienView}" SelectedItem="{Binding UngVienDangChon}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="190"/>
                                                <DataGridTextColumn Header="Vị trí ứng tuyển" Binding="{Binding ViTri}" Width="260"/>
                                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="230"/>
                                                <DataGridTextColumn Header="Điện thoại" Binding="{Binding DienThoai}" Width="150"/>
                                                <DataGridTextColumn Header="Giai đoạn" Binding="{Binding GiaiDoan}" Width="170"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Chấm công}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,18">
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Lượt chấm công" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding SoChamCongDaLoc}" FontSize="30" FontWeight="SemiBold" Foreground="#172033" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding KhungThoiGianChamCong}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Đang trong ca" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding SoCaDangMoDaLoc}" FontSize="30" FontWeight="SemiBold" Foreground="#B45309" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding TyLeHoanTatChamCongDaLoc, StringFormat=Đã ra ca: {0}}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Tổng giờ công" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding TongGioChamCongDaLoc, StringFormat={}{0:N2} giờ}" FontSize="30" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding TongNgayCongChamCongDaLoc, StringFormat=Quy đổi: {0:N2} ngày}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource TheNho}">
                                        <StackPanel>
                                            <TextBlock Text="Cần rà soát" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding SoCaCanRaSoatDaLoc}" FontSize="30" FontWeight="SemiBold" Foreground="#B42318" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding NhanVienCongCaoHienThi, StringFormat=Công cao: {0}}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="360"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource TheThongKe}" Margin="0,0,18,0">
                                        <StackPanel>
                                            <TextBlock Text="Bảng điều khiển ca" Style="{StaticResource TieuDeKhuVuc}"/>
                                            <TextBlock Text="Tình trạng ca của nhân viên đang chọn và công tháng hiện tại." Style="{StaticResource MoTaNho}" Margin="0,4,0,16"/>

                                            <TextBlock Text="NHÂN VIÊN THAO TÁC" Style="{StaticResource NhanTruong}"/>
                                            <ComboBox ItemsSource="{Binding NhanVienTrongPhamVi}" DisplayMemberPath="HoTen" SelectedItem="{Binding NhanVienDangChon, Mode=TwoWay}" Padding="10" Margin="0,0,0,16"/>

                                            <Grid Margin="0,0,0,16">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding NhanVienThaoTac}" FontWeight="SemiBold" Foreground="#172033" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1" Text="{Binding TrangThaiCaDangChon}" Foreground="#0F766E" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="2" Text="{Binding CaGanNhatDangChon}" Style="{StaticResource MoTaNho}" Margin="0,6,0,0"/>
                                                <TextBlock Grid.Row="3" Text="{Binding TongGioCongThangDangChon, StringFormat=Công tháng: {0:N2} giờ}" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                            </Grid>

                                            <UniformGrid Columns="2" Rows="1" Margin="0,0,0,10">
                                                <Button Content="Vào ca" Command="{Binding VaoCaLenh}" Style="{StaticResource NutChinh}" Margin="0,0,6,0"/>
                                                <Button Content="Ra ca" Command="{Binding RaCaLenh}" Style="{StaticResource NutPhu}" Margin="6,0,0,0"/>
                                            </UniformGrid>
                                            <Button Content="Điều chỉnh công đã chọn" Command="{Binding DieuChinhCongLenh}" Style="{StaticResource NutPhu}" HorizontalAlignment="Stretch" Margin="0,0,0,14"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Ngày công" Style="{StaticResource MoTaNho}"/>
                                                    <TextBlock Text="{Binding NgayCongQuyDoiDangChon, StringFormat={}{0:N2}}" FontSize="24" FontWeight="SemiBold" Foreground="#0F766E"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Đủ công" Style="{StaticResource MoTaNho}"/>
                                                    <TextBlock Text="{Binding SoCaDuCongDaLoc}" FontSize="24" FontWeight="SemiBold" Foreground="#172033"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource TheThongKe}" Padding="0">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" Margin="22,20,22,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Sổ công vận hành" Style="{StaticResource TieuDeKhuVuc}"/>
                                                    <TextBlock Text="Theo dõi ca làm theo ngày, phòng ban, trạng thái và nhân sự." Style="{StaticResource MoTaNho}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Làm mới" Command="{Binding TaiLaiLenh}" Style="{StaticResource NutPhu}" VerticalAlignment="Top"/>
                                            </Grid>

                                            <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                                <WrapPanel>
                                                    <StackPanel Width="200" Margin="0,0,12,10">
                                                        <TextBlock Text="TỪ KHÓA" Style="{StaticResource NhanTruong}"/>
                                                        <TextBox Text="{Binding TuKhoaChamCong, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Padding="10" ToolTip="Tìm theo tên, phòng ban, chức vụ hoặc trạng thái"/>
                                                    </StackPanel>
                                                    <StackPanel Width="145" Margin="0,0,12,10">
                                                        <TextBlock Text="TỪ NGÀY" Style="{StaticResource NhanTruong}"/>
                                                        <DatePicker SelectedDate="{Binding TuNgayChamCong, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Width="145" Margin="0,0,12,10">
                                                        <TextBlock Text="ĐẾN NGÀY" Style="{StaticResource NhanTruong}"/>
                                                        <DatePicker SelectedDate="{Binding DenNgayChamCong, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Width="185" Margin="0,0,12,10">
                                                        <TextBlock Text="PHÒNG BAN" Style="{StaticResource NhanTruong}"/>
                                                        <ComboBox ItemsSource="{Binding CacPhongBanTraCuu}" SelectedItem="{Binding PhongBanChamCongDangChon, Mode=TwoWay}" Padding="10"/>
                                                    </StackPanel>
                                                    <StackPanel Width="165" Margin="0,0,0,10">
                                                        <TextBlock Text="TRẠNG THÁI" Style="{StaticResource NhanTruong}"/>
                                                        <ComboBox ItemsSource="{Binding CacTrangThaiChamCong}" SelectedItem="{Binding TrangThaiChamCongDangChon, Mode=TwoWay}" Padding="10"/>
                                                    </StackPanel>
                                                </WrapPanel>
                                            </Border>

                                            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="{StaticResource MauVien}" BorderThickness="0,0,0,1" Padding="18,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SoChamCongDaLoc, StringFormat=Bản ghi: {0}}" Foreground="#172033" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                                    <TextBlock Text="{Binding TongGioChamCongDaLoc, StringFormat=Tổng giờ: {0:N2}}" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                                    <TextBlock Text="{Binding TongNgayCongChamCongDaLoc, StringFormat=Ngày công: {0:N2}}" Foreground="#0F766E" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                                    <TextBlock Text="{Binding SoCaCanRaSoatDaLoc, StringFormat=Rà soát: {0}}" Foreground="#B42318" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>

                                            <DataGrid ItemsSource="{Binding DanhSachChamCongView}" SelectedItem="{Binding ChamCongDangChon}" Margin="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ngày" Binding="{Binding NgayChamCongHienThi}" Width="115"/>
                                                    <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="220"/>
                                                    <DataGridTextColumn Header="Ca" Binding="{Binding CaLam}" Width="115"/>
                                                    <DataGridTextColumn Header="Khung giờ" Binding="{Binding KhungGioHienThi}" Width="145"/>
                                                    <DataGridTextColumn Header="Số giờ" Binding="{Binding SoGioTinhToan, StringFormat=N2}" Width="95"/>
                                                    <DataGridTextColumn Header="Ngày công" Binding="{Binding NgayCongQuyDoi, StringFormat=N2}" Width="105"/>
                                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiCong}" Width="140"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Nghỉ phép}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource TheThongKe}" Margin="0,0,18,0">
                                    <StackPanel>
                                        <TextBlock Text="Tạo đơn nghỉ" Style="{StaticResource TieuDeKhuVuc}"/>
                                        <TextBlock Text="Mẫu nhập liệu theo luồng nghỉ phép." Style="{StaticResource MoTaNho}" Margin="0,4,0,18"/>
                                        <TextBlock Text="Nhân viên" Style="{StaticResource NhanTruong}"/>
                                        <ComboBox ItemsSource="{Binding NhanVienTrongPhamVi}" DisplayMemberPath="HoTen" SelectedValuePath="MaNhanVien" SelectedValue="{Binding BieuMauNghiPhep.MaNhanVien}" Padding="10" Margin="0,0,0,12"/>
                                        <TextBlock Text="Loại nghỉ" Style="{StaticResource NhanTruong}"/>
                                        <TextBox Text="{Binding BieuMauNghiPhep.LoaiNghi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Từ ngày" Style="{StaticResource NhanTruong}"/>
                                        <DatePicker SelectedDate="{Binding BieuMauNghiPhep.TuNgay}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Đến ngày" Style="{StaticResource NhanTruong}"/>
                                        <DatePicker SelectedDate="{Binding BieuMauNghiPhep.DenNgay}" Margin="0,0,0,18"/>
                                        <Button Content="Gửi đơn nghỉ" Command="{Binding TaoNghiPhepLenh}" Style="{StaticResource NutChinh}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource TheThongKe}" Padding="0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="22,20,22,14">
                                            <TextBlock Text="Hàng đợi duyệt nghỉ phép" Style="{StaticResource TieuDeKhuVuc}"/>
                                            <TextBlock Text="Quản lý trạng thái chờ duyệt, đã duyệt hoặc từ chối." Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Duyệt đơn" Command="{Binding DuyetNghiPhepLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"/>
                                                    <Button Content="Từ chối" Command="{Binding TuChoiNghiPhepLenh}" Style="{StaticResource NutNguyHiem}" Margin="0,0,8,0"/>
                                                    <Button Content="Làm mới" Command="{Binding TaiLaiLenh}" Style="{StaticResource NutPhu}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Kỳ xem ai nghỉ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1F6F78" Margin="0,0,8,0"/>
                                                    <ComboBox ItemsSource="{Binding CacKyBaoCaoNhanSu}" SelectedItem="{Binding KyBaoCaoNhanSuDangChon, Mode=TwoWay}" Padding="8" Width="140"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="{StaticResource MauVien}" BorderThickness="0,0,0,1" Padding="18,12">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding TieuDeAiDangNghi}" FontWeight="SemiBold" Foreground="#172033"/>
                                                    <TextBlock Text="{Binding MoTaAiDangNghi}" Style="{StaticResource MoTaNho}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding DanhSachNghiPhepDaDuyetTheoKy}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,8" Background="#F8FAFC" Width="230">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding NhanVien}" FontWeight="SemiBold" Foreground="#172033" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding LoaiNghi}" Style="{StaticResource MoTaNho}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Foreground="#0F766E" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0">
                                                                        <TextBlock.Text>
                                                                            <MultiBinding StringFormat="{}{0:dd/MM/yyyy} - {1:dd/MM/yyyy}">
                                                                                <Binding Path="TuNgay"/>
                                                                                <Binding Path="DenNgay"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </Border>
                                        <DataGrid ItemsSource="{Binding DanhSachNghiPhepView}" SelectedItem="{Binding NghiPhepDangChon}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="220"/>
                                                <DataGridTextColumn Header="Loại nghỉ" Binding="{Binding LoaiNghi}" Width="190"/>
                                                <DataGridTextColumn Header="Từ ngày" Binding="{Binding TuNgay, StringFormat=dd/MM/yyyy}" Width="130"/>
                                                <DataGridTextColumn Header="Đến ngày" Binding="{Binding DenNgay, StringFormat=dd/MM/yyyy}" Width="130"/>
                                                <DataGridTextColumn Header="Số ngày" Binding="{Binding SoNgay}" Width="100"/>
                                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="150"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Đánh giá}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource TheThongKe}" Margin="0,0,18,0">
                                    <StackPanel>
                                        <TextBlock Text="Phiếu đánh giá" Style="{StaticResource TieuDeKhuVuc}"/>
                                        <TextBlock Text="Kỳ, điểm số, nhận xét và trạng thái xử lý." Style="{StaticResource MoTaNho}" Margin="0,4,0,18"/>

                                        <TextBlock Text="Nhân viên" Style="{StaticResource NhanTruong}"/>
                                        <ComboBox ItemsSource="{Binding NhanVienTrongPhamVi}" DisplayMemberPath="HoTen" SelectedValuePath="MaNhanVien" SelectedValue="{Binding BieuMauDanhGia.MaNhanVien}" Padding="10" Margin="0,0,0,12"/>

                                        <TextBlock Text="Người đánh giá" Style="{StaticResource NhanTruong}"/>
                                        <ComboBox ItemsSource="{Binding NhanVienTrongPhamVi}" DisplayMemberPath="HoTen" SelectedValuePath="MaNhanVien" SelectedValue="{Binding BieuMauDanhGia.MaNguoiDanhGia}" Padding="10" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Kỳ đánh giá" Style="{StaticResource NhanTruong}"/>
                                                <TextBox Text="{Binding BieuMauDanhGia.KyDanhGia, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Điểm" Style="{StaticResource NhanTruong}"/>
                                                <TextBox Text="{Binding BieuMauDanhGia.Diem, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Trạng thái" Style="{StaticResource NhanTruong}"/>
                                        <ComboBox ItemsSource="{Binding CacTrangThaiDanhGia}" SelectedItem="{Binding BieuMauDanhGia.TrangThai}" Padding="10" Margin="0,0,0,12"/>

                                        <TextBlock Text="Nhận xét" Style="{StaticResource NhanTruong}"/>
                                        <TextBox Text="{Binding BieuMauDanhGia.NhanXet, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" MinHeight="118" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                                        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,10">
                                            <Button Content="Tạo mới" Command="{Binding TaoMoiDanhGiaLenh}" Style="{StaticResource NutPhu}" Margin="0,0,6,0"/>
                                            <Button Content="Lưu đánh giá" Command="{Binding TaoDanhGiaLenh}" Style="{StaticResource NutChinh}" Margin="6,0,0,0"/>
                                        </UniformGrid>
                                        <Button Content="Nạp dòng đang chọn để sửa" Command="{Binding SuaDanhGiaLenh}" Style="{StaticResource NutPhu}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource TheThongKe}" Padding="0">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="22,20,22,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Đánh giá năng lực" Style="{StaticResource TieuDeKhuVuc}"/>
                                                <TextBlock Text="Theo dõi chu kỳ đánh giá, điểm số, nhận xét và trạng thái hoàn tất." Style="{StaticResource MoTaNho}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Làm mới" Command="{Binding TaiLaiLenh}" Style="{StaticResource NutPhu}" VerticalAlignment="Top"/>
                                        </Grid>

                                        <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Nạp để sửa" Command="{Binding SuaDanhGiaLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                                <Button Content="Chốt kết quả" Command="{Binding ChotDanhGiaLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"/>
                                                <Button Content="Xóa đánh giá" Command="{Binding XoaDanhGiaLenh}" Style="{StaticResource NutNguyHiem}"/>
                                            </StackPanel>
                                        </Border>

                                        <DataGrid ItemsSource="{Binding DanhSachDanhGiaView}" SelectedItem="{Binding DanhGiaDangChon}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="200"/>
                                                <DataGridTextColumn Header="Người đánh giá" Binding="{Binding NguoiDanhGia}" Width="200"/>
                                                <DataGridTextColumn Header="Kỳ" Binding="{Binding KyDanhGia}" Width="120"/>
                                                <DataGridTextColumn Header="Điểm" Binding="{Binding Diem, StringFormat=N1}" Width="90"/>
                                                <DataGridTextColumn Header="Nhận xét" Binding="{Binding NhanXet}" Width="*"/>
                                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="140"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Bảng lương}">
                                <Border Style="{StaticResource TheThongKe}" Padding="0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="22,20,22,14">
                                            <TextBlock Text="Bảng lương" Style="{StaticResource TieuDeKhuVuc}"/>
                                            <TextBlock Text="Tổng hợp từ hợp đồng, ngày công, nghỉ phép, phụ cấp, khấu trừ và trạng thái chi trả." Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                            <WrapPanel>
                                                <StackPanel Width="230" Margin="0,0,12,10">
                                                    <TextBlock Text="NHÂN VIÊN TÍNH LƯƠNG" Style="{StaticResource NhanTruong}"/>
                                                    <ComboBox ItemsSource="{Binding NhanVienTrongPhamVi}" DisplayMemberPath="HoTen" SelectedItem="{Binding NhanVienDangChon, Mode=TwoWay}" Padding="8"/>
                                                </StackPanel>
                                                <StackPanel Width="190" Margin="0,0,12,10">
                                                    <TextBlock Text="TÌM BẢNG LƯƠNG" Style="{StaticResource NhanTruong}"/>
                                                    <TextBox Text="{Binding TuKhoaBangLuong, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Padding="10" ToolTip="Tìm theo tên, kỳ lương hoặc trạng thái"/>
                                                </StackPanel>
                                                <StackPanel Width="190" Margin="0,0,14,10">
                                                    <TextBlock Text="PHÒNG BAN" Style="{StaticResource NhanTruong}"/>
                                                    <ComboBox ItemsSource="{Binding CacPhongBanTraCuu}" SelectedItem="{Binding PhongBanBangLuongDangChon, Mode=TwoWay}" Padding="10"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                                    <Button Content="Tính lương" Command="{Binding TinhLuongLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"
                                                            Visibility="{Binding CoQuyenXuLyBangLuong, Converter={StaticResource HienThiTheoBool}}"/>
                                                    <Button Content="Xem phiếu lương" Command="{Binding XemPhieuLuongLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                                    <Button Content="Xác nhận đã chi trả" Command="{Binding XacNhanTraLuongLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"
                                                            Visibility="{Binding CoQuyenXuLyBangLuong, Converter={StaticResource HienThiTheoBool}}"/>
                                                    <Button Content="Xuất báo cáo lương" Command="{Binding XuatBaoCaoLuongLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"
                                                            Visibility="{Binding CoQuyenXuLyBangLuong, Converter={StaticResource HienThiTheoBool}}"/>
                                                    <Button Content="Làm mới" Command="{Binding TaiLaiLenh}" Style="{StaticResource NutPhu}"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </Border>
                                        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="{StaticResource MauVien}" BorderThickness="0,0,0,1" Padding="18,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding NhanVienThaoTac}" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,24,0"/>
                                                <TextBlock Text="{Binding LuongCoBanDuKienDangChon, StringFormat=Lương cơ bản: {0:N0} đ}" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                                <TextBlock Text="{Binding NgayCongQuyDoiDangChon, StringFormat=Ngày công tính lương: {0:N2}}" Foreground="#0F766E" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="{StaticResource MauVien}" BorderThickness="0,0,0,1" Padding="18,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SoPhieuLuongDaLoc, StringFormat=Phiếu theo bộ lọc: {0}}" Foreground="#172033" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                                <TextBlock Text="{Binding TongThucLanhDaLoc, StringFormat=Tổng thực lãnh: {0:N0} đ}" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                                <TextBlock Text="{Binding LuongCaoBangLuongHienThi, StringFormat=Lương cao nhất: {0}}" Foreground="#B45309" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <DataGrid ItemsSource="{Binding DanhSachPhieuLuongView}" SelectedItem="{Binding PhieuLuongDangChon}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="210"/>
                                                <DataGridTextColumn Header="Kỳ lương" Binding="{Binding KyLuong}" Width="120"/>
                                                <DataGridTextColumn Header="Lương cơ bản" Binding="{Binding LuongCoBan, StringFormat={}{0:N0} đ}" Width="160"/>
                                                <DataGridTextColumn Header="Phụ cấp" Binding="{Binding PhuCap, StringFormat={}{0:N0} đ}" Width="140"/>
                                                <DataGridTextColumn Header="Khấu trừ" Binding="{Binding KhauTru, StringFormat={}{0:N0} đ}" Width="140"/>
                                                <DataGridTextColumn Header="Thực lãnh" Binding="{Binding ThucLanh, StringFormat={}{0:N0} đ}" Width="160"/>
                                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="140"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Báo cáo}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,18">
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Hồ sơ nhân sự" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding TongNhanVien}" FontSize="30" FontWeight="SemiBold" Foreground="#172033" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding DangLamViec, StringFormat=Quân số hiện diện: {0}}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Chấm công trong kỳ" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding SoChamCongTrongKyBaoCao}" FontSize="30" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding TongGioCongTrongKyBaoCao, StringFormat=Tổng giờ: {0:N2}}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Nghỉ phép trong kỳ" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding SoNghiPhepTrongKyBaoCao}" FontSize="30" FontWeight="SemiBold" Foreground="#B45309" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding NhanSuNghiDaDuyetTrongKyBaoCao, StringFormat=Nhân sự nghỉ duyệt: {0}}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource TheNho}">
                                        <StackPanel>
                                            <TextBlock Text="Phiếu lương trong kỳ" Style="{StaticResource MoTaNho}"/>
                                            <TextBlock Text="{Binding SoPhieuLuongTrongKyBaoCao}" FontSize="30" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding KyLuongGanNhatHienThi, StringFormat=Kỳ gần nhất: {0}}" Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Grid.Row="1" Style="{StaticResource VienCongCu}" Margin="0,0,0,18">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left" Width="220" Margin="0,0,18,0">
                                            <TextBlock Text="KỲ BÁO CÁO" Style="{StaticResource NhanTruong}"/>
                                            <ComboBox ItemsSource="{Binding CacKyBaoCaoNhanSu}" SelectedItem="{Binding KyBaoCaoNhanSuDangChon, Mode=TwoWay}" Padding="10"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TomTatBaoCaoNhanSu}" VerticalAlignment="Bottom" FontWeight="SemiBold" Foreground="#172033" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>

                                <UniformGrid Grid.Row="2" Columns="2" Rows="2">
                                    <Border Style="{StaticResource TheNho}" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="Báo cáo hồ sơ nhân viên" Style="{StaticResource TieuDeKhuVuc}"/>
                                            <TextBlock Text="Xuất danh sách hồ sơ theo bộ lọc tên, phòng ban và thứ bậc chức vụ hiện tại." Style="{StaticResource MoTaNho}" Margin="0,6,0,16"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SoNhanVienHoSo, StringFormat=Hồ sơ theo bộ lọc: {0}}" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,24,0"/>
                                                <TextBlock Text="{Binding CaNhanXuatSacHoSoHienThi, StringFormat=Xuất sắc: {0}}" FontWeight="SemiBold" Foreground="#0F766E"/>
                                            </StackPanel>
                                            <Button Content="Xuất hồ sơ nhân viên" Command="{Binding XuatBaoCaoNhanVienLenh}" Style="{StaticResource NutChinh}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource TheNho}" Margin="12,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Báo cáo chấm công" Style="{StaticResource TieuDeKhuVuc}"/>
                                            <TextBlock Text="Tổng hợp công theo kỳ báo cáo, bộ lọc tên và phòng ban đang đặt ở trang Chấm công." Style="{StaticResource MoTaNho}" Margin="0,6,0,16"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SoChamCongDaLoc, StringFormat=Lượt theo bộ lọc: {0}}" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,24,0"/>
                                                <TextBlock Text="{Binding NhanVienCongCaoHienThi, StringFormat=Công cao: {0}}" FontWeight="SemiBold" Foreground="#0F766E"/>
                                            </StackPanel>
                                            <Button Content="Xuất chấm công" Command="{Binding XuatBaoCaoChamCongLenh}" Style="{StaticResource NutChinh}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource TheNho}" Margin="0,12,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Báo cáo nghỉ phép" Style="{StaticResource TieuDeKhuVuc}"/>
                                            <TextBlock Text="Tổng hợp đơn nghỉ theo ngày, tháng, quý hoặc năm để trưởng phòng và giám đốc duyệt nhanh." Style="{StaticResource MoTaNho}" Margin="0,6,0,16"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SoNghiPhepTrongKyBaoCao, StringFormat=Đơn trong kỳ: {0}}" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,24,0"/>
                                                <TextBlock Text="{Binding QuanSoHienDienTrongKyBaoCao, StringFormat=Quân số hiện diện: {0}}" FontWeight="SemiBold" Foreground="#B45309"/>
                                            </StackPanel>
                                            <Button Content="Xuất nghỉ phép" Command="{Binding XuatBaoCaoNghiPhepLenh}" Style="{StaticResource NutChinh}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource TheNho}" Margin="12,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Báo cáo lương nhân sự" Style="{StaticResource TieuDeKhuVuc}"/>
                                            <TextBlock Text="Tổng hợp lương theo kỳ báo cáo, bộ lọc tên và phòng ban đang đặt ở trang Bảng lương." Style="{StaticResource MoTaNho}" Margin="0,6,0,16"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SoPhieuLuongDaLoc, StringFormat=Phiếu theo bộ lọc: {0}}" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,24,0"/>
                                                <TextBlock Text="{Binding LuongCaoBangLuongHienThi, StringFormat=Lương cao: {0}}" FontWeight="SemiBold" Foreground="#2563EB"/>
                                            </StackPanel>
                                            <Button Content="Xuất báo cáo lương" Command="{Binding XuatBaoCaoLuongLenh}" Style="{StaticResource NutChinh}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>

                            <Grid Visibility="{Binding MucDangChon, Converter={StaticResource HienThiTheoMuc}, ConverterParameter=Cài đặt tài khoản}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource TheThongKe}" Margin="0,0,18,0">
                                    <StackPanel>
                                        <TextBlock Text="Phiên đăng nhập" Style="{StaticResource TieuDeKhuVuc}"/>
                                        <TextBlock Text="Thông tin tài khoản đang sử dụng." Style="{StaticResource MoTaNho}" Margin="0,4,0,18"/>

                                        <TextBlock Text="TÊN ĐĂNG NHẬP" Style="{StaticResource NhanTruong}"/>
                                        <TextBlock Text="{Binding TenDangNhap}" FontSize="18" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,14"/>

                                        <TextBlock Text="NGƯỜI DÙNG" Style="{StaticResource NhanTruong}"/>
                                        <TextBlock Text="{Binding TenNguoiDung}" FontSize="18" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,14"/>

                                        <TextBlock Text="VAI TRÒ" Style="{StaticResource NhanTruong}"/>
                                        <TextBlock Text="{Binding VaiTroNguoiDung}" FontSize="18" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,14"/>

                                        <TextBlock Text="QUYỀN HẠN" Style="{StaticResource NhanTruong}"/>
                                        <TextBlock Text="{Binding MoTaQuyenNguoiDung}" Style="{StaticResource MoTaNho}" Margin="0,0,0,14"/>

                                        <TextBlock Text="NGÀY GIỜ" Style="{StaticResource NhanTruong}"/>
                                        <TextBlock Text="{Binding ThoiGianHienTai}" FontSize="18" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,22"/>

                                        <Button Content="Đặt lại mật khẩu tài khoản chọn" Command="{Binding DatLaiMatKhauLenh}" Style="{StaticResource NutPhu}" Margin="0,0,0,10"/>
                                        <Button Content="Đồng bộ tài khoản nhân sự" Command="{Binding TaoTaiKhoanMauLenh}" Style="{StaticResource NutChinh}" Margin="0,0,0,18"/>

                                        <TextBlock Text="SAO LƯU DỮ LIỆU" Style="{StaticResource NhanTruong}"/>
                                        <Button Content="Sao lưu dữ liệu" Command="{Binding SaoLuuDuLieuLenh}" Style="{StaticResource NutPhu}" Margin="0,0,0,10"/>
                                        <Button Content="Phục hồi từ bản sao" Command="{Binding PhucHoiDuLieuLenh}" Style="{StaticResource NutNguyHiem}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource TheThongKe}" Padding="0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="22,20,22,14">
                                            <TextBlock Text="Cài đặt tài khoản" Style="{StaticResource TieuDeKhuVuc}"/>
                                            <TextBlock Text="Quản lý tài khoản Admin, Giám đốc, Trưởng phòng và Nhân viên." Style="{StaticResource MoTaNho}"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource VienCongCu}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Đồng bộ tài khoản nhân sự" Command="{Binding TaoTaiKhoanMauLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"/>
                                                <Button Content="Khóa hoặc mở tài khoản" Command="{Binding KhoaMoTaiKhoanLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                                                <Button Content="Đặt lại mật khẩu" Command="{Binding DatLaiMatKhauLenh}" Style="{StaticResource NutPhu}"/>
                                            </StackPanel>
                                        </Border>
                                        <DataGrid ItemsSource="{Binding CacTaiKhoanHeThong}" SelectedItem="{Binding TaiKhoanDangChon}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Tài khoản" Binding="{Binding TenDangNhap}" Width="150"/>
                                                <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="220"/>
                                                <DataGridTextColumn Header="Vai trò" Binding="{Binding VaiTro}" Width="150"/>
                                                <DataGridTextColumn Header="Quyền hạn" Binding="{Binding QuyenHan}" Width="*"/>
                                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="150"/>
                                                <DataGridTextColumn Header="Đăng nhập gần nhất" Binding="{Binding LanDangNhapGanNhat, StringFormat=HH:mm dd/MM/yyyy}" Width="180"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
