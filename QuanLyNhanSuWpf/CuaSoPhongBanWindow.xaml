<Window x:Class="QuanLyNhanSuWpf.CuaSoPhongBanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phòng ban" Height="520" Width="620"
        MinHeight="460" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Border Margin="18" Style="{StaticResource TheThongKe}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Phòng ban" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}"/>
                <TextBlock Text="Tạo hoặc cập nhật phòng ban, đồng thời chọn người phụ trách." Style="{StaticResource MoTaNho}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Lưu thay đổi" Command="{Binding LuuPhongBanLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"/>
                <Button Content="Gán trưởng phòng" Command="{Binding GanTruongPhongLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                <Button Content="Đóng" IsCancel="True" Style="{StaticResource NutPhu}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Mã phòng" Style="{StaticResource NhanTruong}"/>
                <TextBox Text="{Binding BieuMauPhongBan.MaPhongBan}" Style="{StaticResource OThongTin}" IsReadOnly="True" Margin="0,0,0,12"/>

                <TextBlock Text="Tên phòng ban" Style="{StaticResource NhanTruong}"/>
                <TextBox Text="{Binding BieuMauPhongBan.TenPhongBan, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>

                <TextBlock Text="Trưởng phòng" Style="{StaticResource NhanTruong}"/>
                <ComboBox ItemsSource="{Binding NhanVienCoTheBoNhiemTruongPhong}" DisplayMemberPath="HoTen" SelectedValuePath="MaNhanVien"
                          SelectedValue="{Binding BieuMauPhongBan.MaTruongPhong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,12"/>

                <Border Background="#F8FAFC" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Phòng ban đang chọn" Style="{StaticResource NhanTruong}"/>
                        <TextBlock Text="{Binding PhongBanDangChon.TenPhongBan, TargetNullValue=Chưa chọn phòng ban}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
