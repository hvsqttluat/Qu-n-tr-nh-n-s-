<Window x:Class="QuanLyNhanSuWpf.CuaSoUngVienWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ứng viên" Height="620" Width="660"
        MinHeight="560" MinWidth="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Border Margin="18" Style="{StaticResource TheThongKe}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Hồ sơ ứng viên" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}"/>
                <TextBlock Text="Tiếp nhận hoặc cập nhật ứng viên trong pipeline tuyển dụng." Style="{StaticResource MoTaNho}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Lưu ứng viên" Command="{Binding TaoUngVienLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"/>
                <Button Content="Đóng" IsCancel="True" Style="{StaticResource NutPhu}"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Họ tên" Style="{StaticResource NhanTruong}"/>
                    <TextBox Text="{Binding BieuMauUngVien.HoTen, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                    <TextBlock Text="Email" Style="{StaticResource NhanTruong}"/>
                    <TextBox Text="{Binding BieuMauUngVien.Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                    <TextBlock Text="Số điện thoại" Style="{StaticResource NhanTruong}"/>
                    <TextBox Text="{Binding BieuMauUngVien.DienThoai, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                    <TextBlock Text="Vị trí ứng tuyển" Style="{StaticResource NhanTruong}"/>
                    <ComboBox ItemsSource="{Binding ViTriTrongPhamVi}" DisplayMemberPath="TenViTri" SelectedValuePath="MaViTri"
                              SelectedValue="{Binding BieuMauUngVien.MaViTri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,12"/>
                    <TextBlock Text="Giai đoạn" Style="{StaticResource NhanTruong}"/>
                    <ComboBox ItemsSource="{Binding CacGiaiDoanUngVien}" SelectedItem="{Binding BieuMauUngVien.GiaiDoan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="10"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
