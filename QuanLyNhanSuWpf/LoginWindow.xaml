<Window x:Class="QuanLyNhanSuWpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập hệ thống nhân sự" Height="680" Width="1120"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <Style x:Key="KhungNhapHienDai" TargetType="Border">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#D7E0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="ONhapTrongSuot" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="CaretBrush" Value="#2563EB"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="OMatKhauHienDai" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="CaretBrush" Value="#2563EB"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NhanDangNhap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="NutDangNhapHienDai" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="156"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Khung"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Khung" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Khung" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Khung" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NutThoatHienDai" TargetType="Button" BasedOn="{StaticResource NutDangNhapHienDai}">
            <Setter Property="Background" Value="#EEF4FF"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="MinWidth" Value="112"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Assets/login-background.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Rectangle Fill="#A8111827"/>

        <Grid Margin="42">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <DockPanel LastChildFill="True" Margin="12,8,46,8">
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="62" Height="62" CornerRadius="14" Background="#12B8A6" BorderBrush="#55FFFFFF" BorderThickness="1">
                        <TextBlock Text="HR" Foreground="White" FontWeight="Black" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,6,0,0">
                        <TextBlock Text="Quản trị nhân sự" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Hồ sơ, vận hành và báo cáo tập trung" Foreground="#D7EEF0" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Bottom"
                        Background="#20FFFFFF"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="THỜI GIAN HỆ THỐNG" Foreground="#D7EEF0" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="ThoiGianTextBlock" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#22C55E" CornerRadius="9" Padding="12,8" VerticalAlignment="Center">
                            <TextBlock Text="Online" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel VerticalAlignment="Center" MaxWidth="470">
                    <TextBlock Text="Hệ thống quản lý nhân sự"
                               Foreground="White"
                               FontSize="39"
                               FontWeight="SemiBold"
                               LineHeight="47"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Một không gian làm việc gọn gàng cho quản lý hồ sơ, chấm công, nghỉ phép và tiền lương."
                               Foreground="#E3F2F4"
                               FontSize="15"
                               LineHeight="24"
                               TextWrapping="Wrap"
                               Margin="0,16,18,0"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Column="1"
                    Width="430"
                    Padding="34"
                    Background="#F4FFFFFF"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    CornerRadius="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#020617" BlurRadius="28" ShadowDepth="0" Opacity="0.26"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Đăng nhập tài khoản" FontSize="31" FontWeight="SemiBold" Foreground="#172033"/>
                    <TextBlock Text="Nhập thông tin tài khoản để bắt đầu phiên làm việc."
                               Foreground="#64748B"
                               FontSize="14"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               Margin="0,10,0,30"/>

                    <TextBlock Text="Tên đăng nhập" Style="{StaticResource NhanDangNhap}"/>
                    <Border Style="{StaticResource KhungNhapHienDai}">
                        <TextBox x:Name="TenDangNhapTextBox" Style="{StaticResource ONhapTrongSuot}"/>
                    </Border>

                    <TextBlock Text="Mật khẩu" Style="{StaticResource NhanDangNhap}"/>
                    <Border Style="{StaticResource KhungNhapHienDai}" Margin="0,0,0,12">
                        <PasswordBox x:Name="MatKhauPasswordBox"
                                     Style="{StaticResource OMatKhauHienDai}"
                                     KeyDown="NhapMatKhau_KeyDown"/>
                    </Border>

                    <TextBlock x:Name="ThongBaoTextBlock"
                               Foreground="{StaticResource MauNguyHiem}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               MinHeight="28"
                               Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="DangNhapButton"
                                Content="Đăng nhập"
                                Click="DangNhap_Click"
                                Style="{StaticResource NutDangNhapHienDai}"
                                Margin="0,0,12,0"/>
                        <Button Content="Thoát"
                                Click="Thoat_Click"
                                Style="{StaticResource NutThoatHienDai}"/>
                    </StackPanel>

                    <TextBlock Text="Dữ liệu đăng nhập được kiểm tra và ghi nhận theo phiên làm việc."
                               Foreground="#64748B"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,26,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
