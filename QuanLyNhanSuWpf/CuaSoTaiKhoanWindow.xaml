<Window x:Class="QuanLyNhanSuWpf.CuaSoTaiKhoanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tài khoản hệ thống" Height="640" Width="680"
        MinHeight="560" MinWidth="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Border Margin="18" Style="{StaticResource TheThongKe}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="{Binding BieuMauTaiKhoan.TieuDe}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}"/>
                <TextBlock Text="Nhập thông tin tài khoản, vai trò, trạng thái và mật khẩu mới nếu cần đổi." Style="{StaticResource MoTaNho}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Lưu tài khoản" Command="{Binding LuuTaiKhoanLenh}" Style="{StaticResource NutChinh}" Margin="0,0,8,0"/>
                <Button Content="Đặt lại mật khẩu" Command="{Binding DatLaiMatKhauLenh}" Style="{StaticResource NutPhu}" Margin="0,0,8,0"/>
                <Button Content="Đóng" IsCancel="True" Style="{StaticResource NutPhu}"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Tên đăng nhập" Style="{StaticResource NhanTruong}"/>
                    <TextBox Text="{Binding BieuMauTaiKhoan.TenDangNhap, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                    <TextBlock Text="Họ tên" Style="{StaticResource NhanTruong}"/>
                    <TextBox Text="{Binding BieuMauTaiKhoan.HoTen, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                    <TextBlock Text="Vai trò" Style="{StaticResource NhanTruong}"/>
                    <ComboBox ItemsSource="{Binding CacVaiTroTaiKhoan}" SelectedItem="{Binding BieuMauTaiKhoan.VaiTro}" Padding="10" Margin="0,0,0,12"/>
                    <TextBlock Text="Mật khẩu mới" Style="{StaticResource NhanTruong}"/>
                    <TextBox Text="{Binding BieuMauTaiKhoan.MatKhauMoi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OThongTin}" Margin="0,0,0,12"/>
                    <CheckBox Content="Đang hoạt động" IsChecked="{Binding BieuMauTaiKhoan.DangHoatDong}" Margin="0,0,0,16"/>

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Tài khoản đang chọn" Style="{StaticResource NhanTruong}"/>
                            <TextBlock Text="{Binding TaiKhoanDangChon.TenDangNhap, TargetNullValue=Chưa chọn tài khoản}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TaiKhoanDangChon.TrangThai}" Style="{StaticResource MoTaNho}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
