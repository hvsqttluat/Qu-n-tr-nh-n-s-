<UserControl x:Class="HRM_WPF_CNPM.Views.ContractView"
             xmlns="http://schemas.microsoft.com/winfx/2000/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:local="clr-namespace:HRM_WPF_CNPM.Views"
             xmlns:vm="clr-namespace:HRM_WPF_CNPM.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#FAFAFA">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="QUẢN LÝ HỢP ĐỒNG LAO ĐỘNG" 
                       FontSize="24" 
                       FontWeight="Black" 
                       Foreground="#2D3A2D"/>
            <TextBlock Text="Theo dõi, gia hạn, thanh lý hoặc sửa đổi các loại phân khu giao hảo lao động" 
                       FontSize="12" 
                       Foreground="Gray" 
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Command, Filters & Search Row -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Text Search Input -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ui:ControlHelper.PlaceholderText="Mã hợp đồng, mã hoặc tên nhân viên..."
                         HorizontalAlignment="Stretch"
                         Height="34"
                         Margin="0,0,12,0"
                         ui:ControlHelper.CornerRadius="6"/>

                <!-- 2. Type Filter ComboBox -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Loại HĐ:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Foreground="#555"/>
                    <ComboBox ItemsSource="{Binding TypeFilterList}"
                              SelectedItem="{Binding SelectedTypeFilter}"
                              Width="140"
                              Height="34"
                              ui:ControlHelper.CornerRadius="6"/>
                </StackPanel>

                <!-- 3. Status Filter ComboBox -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Foreground="#555"/>
                    <ComboBox ItemsSource="{Binding StatusFilterList}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              Width="140"
                              Height="34"
                              ui:ControlHelper.CornerRadius="6"/>
                </StackPanel>

                <!-- 4. Quick Expiring Filter Buttons -->
                <CheckBox Grid.Column="3" 
                          IsChecked="{Binding IsExpiringSoonFilter, Mode=TwoWay}"
                          Content="Sắp hết hạn (30 ngày)"
                          VerticalAlignment="Center"
                          FontWeight="Bold"
                          Foreground="#C5A059"
                          Margin="0,0,12,0"/>

                <!-- 5. Reset & Reload Button -->
                <Button Grid.Column="5"
                        Command="{Binding LoadContractsCommand}"
                        Content="🔄 TẢI LẠI DANH SÁCH"
                        Background="#ECECEC"
                        Foreground="#333"
                        FontWeight="Bold"
                        Height="34"
                        Padding="12,0"
                        ui:ControlHelper.CornerRadius="6"/>
            </Grid>
        </Border>

        <!-- Main Body: Split View [DataGrid Left / Input Form Right] -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Contract List Grid -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid ItemsSource="{Binding Contracts}"
                              SelectedItem="{Binding SelectedContract, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Hợp Đồng" Binding="{Binding ContractCode}" Width="110" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Mã NV" Binding="{Binding EmployeeCode}" Width="80"/>
                            <DataGridTextColumn Header="Họ Tên Nhân Sự" Binding="{Binding EmployeeName}" Width="150" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Loại Hợp Đồng" Binding="{Binding ContractType}" Width="110"/>
                            <DataGridTextColumn Header="Bắt Đầu" Binding="{Binding DisplayStartDate}" Width="90"/>
                            <DataGridTextColumn Header="Kết Thúc" Binding="{Binding DisplayEndDate}" Width="95"/>
                            <DataGridTextColumn Header="Lương HĐ" Binding="{Binding DisplaySalary}" Width="105"/>
                            
                            <!-- Custom status cell template styling -->
                            <DataGridTemplateColumn Header="Trạng thái" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Còn hiệu lực">
                                                            <Setter Property="Background" Value="#E8F5E9"/>
                                                            <Setter Property="BorderBrush" Value="#C8E6C9"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Sắp hết hạn">
                                                            <Setter Property="Background" Value="#FFF9C4"/>
                                                            <Setter Property="BorderBrush" Value="#FFF59D"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Hết hạn">
                                                            <Setter Property="Background" Value="#FFEBEE"/>
                                                            <Setter Property="BorderBrush" Value="#FFCDD2"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Đã thanh lý">
                                                            <Setter Property="Background" Value="#F5F5F5"/>
                                                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Còn hiệu lực">
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Sắp hết hạn">
                                                                <Setter Property="Foreground" Value="#F57F17"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Hết hạn">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Đã thanh lý">
                                                                <Setter Property="Foreground" Value="#616161"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1"
                               Text="* Chọn một hợp đồng bất kỳ từ bảng để chuẩn bị tiến trình cập nhật hoặc thanh lý."
                               Foreground="Gray"
                               FontStyle="Italic"
                               FontSize="11"
                               Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <!-- Column 2: Contract Form Details -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Form -->
                        <TextBlock Grid.Row="0" 
                                   Text="💼 CHI TIẾT &amp; CẬP NHẬT HỒ SƠ" 
                                   FontSize="15" 
                                   FontWeight="Black" 
                                   Foreground="#2D3A2D" 
                                   Margin="0,0,0,16"/>

                        <!-- Notification alert banners -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <!-- Error Notification Banner -->
                            <Border Background="#FFEBEE" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#FFCDD2" BorderThickness="1"
                                    Visibility="{Binding ErrorMsg, Converter={x:Static ui:ControlHelper.StringToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚠ " FontWeight="Bold" Foreground="#C62828" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ErrorMsg}" Foreground="#C62828" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Success Notification Banner -->
                            <Border Background="#E8F5E9" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#C8E6C9" BorderThickness="1"
                                    Visibility="{Binding SuccessMsg, Converter={x:Static ui:ControlHelper.StringToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="✔ " FontWeight="Bold" Foreground="#2E7D32" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SuccessMsg}" Foreground="#2E7D32" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Input fields list -->
                        <StackPanel Grid.Row="2" spacing="12">
                            <!-- Contract Code -->
                            <StackPanel>
                                <TextBlock Text="Mã số Hợp đồng *" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingContractCode, UpdateSourceTrigger=PropertyChanged}"
                                         ui:ControlHelper.PlaceholderText="Ví dụ: HDLD-24-001"
                                         Height="34"
                                         ui:ControlHelper.CornerRadius="6"/>
                            </StackPanel>

                            <!-- Employee Assignment Dropdown -->
                            <StackPanel>
                                <TextBlock Text="Cán bộ nhân sự áp dụng *" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Employees}"
                                          SelectedItem="{Binding SelectedEmployeeForForm}"
                                          Height="34"
                                          HorizontalAlignment="Stretch"
                                          ui:ControlHelper.CornerRadius="6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="[" FontWeight="Bold"/><TextBlock Text="{Binding EmployeeCode}" FontWeight="Bold" Foreground="#C5A059"/><TextBlock Text="]" FontWeight="Bold"/>
                                                <TextBlock Text=" - "/>
                                                <TextBlock Text="{Binding FullName}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Contract Type Dropdown -->
                            <StackPanel>
                                <TextBlock Text="Gói / Loại hợp đồng *" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ContractTypes}"
                                          SelectedItem="{Binding EditingContractType}"
                                          Height="34"
                                          HorizontalAlignment="Stretch"
                                          ui:ControlHelper.CornerRadius="6"/>
                            </StackPanel>

                            <!-- StartDate -->
                            <StackPanel>
                                <TextBlock Text="Ngày bắt đầu hiệu lực *" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding EditingStartDate, Mode=TwoWay}"
                                            Height="34"
                                            HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- EndDate (conditional placeholder) -->
                            <StackPanel>
                                <TextBlock Text="Ngày kết thúc *" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding EditingEndDate, Mode=TwoWay}"
                                            Height="34"
                                            HorizontalAlignment="Stretch"/>
                                <TextBlock Text="* Có thể bỏ trống đối với giao hợp Không xác định thời hạn."
                                           FontSize="10.5" Foreground="Gray" Margin="0,2,0,0" FontStyle="Italic"/>
                            </StackPanel>

                            <!-- Contract Salary / Base Level -->
                            <StackPanel>
                                <TextBlock Text="Lương thỏa thuận hợp đồng (VNĐ) *" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingSalary, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         ui:ControlHelper.PlaceholderText="Ví dụ: 15,000,000"
                                         Height="34"
                                         ui:ControlHelper.CornerRadius="6"/>
                            </StackPanel>

                            <!-- Contract Status dropdown for edit override -->
                            <StackPanel>
                                <TextBlock Text="Trạng thái hành chính" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Statuses}"
                                          SelectedItem="{Binding EditingStatus}"
                                          Height="34"
                                          HorizontalAlignment="Stretch"
                                          ui:ControlHelper.CornerRadius="6"/>
                            </StackPanel>

                            <!-- Ghi chú / Note -->
                            <StackPanel>
                                <TextBlock Text="Ghi chú nghiệp vụ" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingNote}"
                                         ui:ControlHelper.PlaceholderText="Các nghĩa vụ bổ sung hoặc đặc cách của quân nhân..."
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Height="60"
                                         ui:ControlHelper.CornerRadius="6"/>
                            </StackPanel>

                            <Separator Margin="0,8,0,8" Background="#E0E0E0"/>

                            <!-- Action buttons row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Add & Save Button -->
                                <Button Grid.Row="0" Grid.Column="0"
                                        Command="{Binding AddCommand}"
                                        Content="➕ THÊM MỚI"
                                        Background="#2D3A2D"
                                        Foreground="#FFFFFF"
                                        FontWeight="Black"
                                        FontSize="11.5"
                                        Height="36"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,6,8"
                                        ui:ControlHelper.CornerRadius="6"/>

                                <!-- Update Button -->
                                <Button Grid.Row="0" Grid.Column="1"
                                        Command="{Binding UpdateCommand}"
                                        Content="💾 CẬP NHẬT"
                                        Background="#1a241a"
                                        Foreground="#C5A059"
                                        FontWeight="Black"
                                        FontSize="11.5"
                                        Height="36"
                                        HorizontalAlignment="Stretch"
                                        Margin="6,0,0,8"
                                        ui:ControlHelper.CornerRadius="6"/>

                                <!-- Clear / Refresh Panel Button -->
                                <Button Grid.Row="1" Grid.Column="0"
                                        Command="{Binding ResetFormCommand}"
                                        Content="🧹 LÀM TRẮNG"
                                        Background="#ECECEC"
                                        Foreground="#333"
                                        FontWeight="Black"
                                        FontSize="11.5"
                                        Height="36"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,6,0"
                                        ui:ControlHelper.CornerRadius="6"/>

                                <!-- Delete Soft-delete Button -->
                                <Button Grid.Row="1" Grid.Column="1"
                                        Command="{Binding DeleteCommand}"
                                        Content="🗑 XÓA MỀM"
                                        Background="#FFEBEE"
                                        Foreground="#C62828"
                                        FontWeight="Black"
                                        FontSize="11.5"
                                        Height="36"
                                        HorizontalAlignment="Stretch"
                                        Margin="6,0,0,0"
                                        ui:ControlHelper.CornerRadius="6"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
