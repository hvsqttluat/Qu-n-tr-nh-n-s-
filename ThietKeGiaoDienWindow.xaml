                        <TextBlock Text="Cài đặt tài khoản" Style="{StaticResource PreviewTitle}"/>
                        <TextBlock Text="Đồng bộ tài khoản nhân sự, khóa/mở tài khoản, đặt lại mật khẩu và sao lưu phục hồi." Style="{StaticResource PreviewSubTitle}"/>
                    </StackPanel>
                    <Border Grid.Column="0" Style="{StaticResource PreviewCard}" Margin="0,92,18,0">
                        <DataGrid Height="430">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tài khoản" Width="150"/>
                                <DataGridTextColumn Header="Họ tên" Width="220"/>
                                <DataGridTextColumn Header="Vai trò" Width="150"/>
                                <DataGridTextColumn Header="Trạng thái" Width="140"/>
                                <DataGridTextColumn Header="Đăng nhập gần nhất" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PreviewCard}" Margin="0,92,0,0">
                        <StackPanel>
                            <TextBlock Text="Thao tác quản trị" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                            <Border Style="{StaticResource PreviewButton}"><TextBlock Text="Đồng bộ tài khoản" Style="{StaticResource PreviewButtonText}"/></Border>
                            <Border Style="{StaticResource PreviewButton}" Background="#EFF6FF" Margin="0,12,8,0"><TextBlock Text="Khóa / mở tài khoản" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border>
                            <Border Style="{StaticResource PreviewButton}" Background="#EFF6FF" Margin="0,12,8,0"><TextBlock Text="Đặt lại mật khẩu" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border>
                            <Border Style="{StaticResource PreviewButton}" Background="#F8FAFC" Margin="0,28,8,0"><TextBlock Text="Sao lưu dữ liệu" Foreground="#334155" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Thông báo">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="2">
                        <TextBlock Text="Thông báo nội bộ" Style="{StaticResource PreviewTitle}"/>
                        <TextBlock Text="Tạo thông báo theo phân hệ, chọn mức độ, đính kèm tệp và lọc thông báo chưa đọc." Style="{StaticResource PreviewSubTitle}"/>
                    </StackPanel>
                    <Border Grid.Column="0" Style="{StaticResource PreviewCard}" Margin="0,92,18,0">
                        <StackPanel>
                            <TextBlock Text="Form tạo thông báo" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                            <TextBlock Text="Tiêu đề" Style="{StaticResource PreviewLabel}"/><Border Style="{StaticResource PreviewInput}"/>
                            <TextBlock Text="Phân hệ" Style="{StaticResource PreviewLabel}"/><Border Style="{StaticResource PreviewInput}"/>
                            <TextBlock Text="Mức độ" Style="{StaticResource PreviewLabel}"/><Border Style="{StaticResource PreviewInput}"/>
                            <TextBlock Text="Nội dung" Style="{StaticResource PreviewLabel}"/><Border Height="110" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource PreviewButton}"><TextBlock Text="Gửi thông báo" Style="{StaticResource PreviewButtonText}"/></Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PreviewCard}" Margin="0,92,0,0">
                        <StackPanel>
                            <TextBlock Text="Danh sách thông báo" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Tìm kiếm, chỉ hiện chưa đọc, đánh dấu đã đọc, mở tệp đính kèm." Foreground="#64748B" Margin="0,8,0,18"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"><TextBlock Text="Khẩn cấp - Chấm công: Nhắc xác nhận ca làm hôm nay"/></Border>
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"><TextBlock Text="Thông tin - Nhân viên: Cập nhật hồ sơ cá nhân"/></Border>
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16"><TextBlock Text="Thành công - Báo cáo: Báo cáo lương đã xuất"/></Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
